# BrokerVerse front end: runtime settings of one environment. Nothing here is baked into the build: the same build
# runs in Dev, SIT, UAT, Pre-Prod and Production. These values are turned into /env-config.js when the front end is
# published (deploy workflow, from the GitHub Environment's variables), or when the web container starts (Docker
# Compose, Railway: set them on the container / service). See deploy/RELEASE_PIPELINE.md section 4.

# API address seen by the browser. Leave EMPTY when the web server or CloudFront forwards /api to the backend (same
# origin, recommended). Otherwise the API's public address ending in /api:
API_BASE_URL=
# API_BASE_URL=https://brokerverse-demo-api.inxtuniverse.com/api

# Web container / server only: where /api is forwarded (same-origin set-up).
# Docker Compose: http://api:8000   Railway: http://api.railway.internal:8000   EC2: http://127.0.0.1:8001
# Azure Container Apps: https://<api app>.internal.<environment domain> (set by Terraform)
API_UPSTREAM=

# Azure only: the Front Door profile ID. Requests that did not come through that Front Door are refused (403).
FRONT_DOOR_ID=

# Label next to the logo and in the browser tab: DEV, SIT, UAT, PREPROD, TRAINING... Empty (or PRODUCTION) in
# production: no label.
ENVIRONMENT_NAME=UAT
# Optional label colour (#rrggbb); defaults per name (DEV slate, SIT violet, UAT amber, PREPROD red).
ENVIRONMENT_COLOR=

# Analytics stay off unless set to true.
ANALYTICS_ENABLED=false

# Older builds only: REACT_APP_BASE_URL was compiled into the build. It is still honoured when /env-config.js names
# no API address, so earlier builds keep working; new builds leave it unset.
# REACT_APP_BASE_URL=https://brokerverse-demo-api.inxtuniverse.com/api
