# BrokerVerse backend environment for production. Placeholders only: put the real values in the secret store
# (AWS Secrets Manager / SSM Parameter Store or the service's environment), never in a repository.
# Details of every variable: deploy/REFERENCE.md.

NODE_ENV=production
PORT=8001

# PostgreSQL 16, database time zone Asia/Manila. On RDS keep ?uselibpqcompat=true&sslmode=require (encrypted; plain
# sslmode=require makes node-postgres verify the Amazon certificate and refuse the connection).
DATABASE_URL=postgres://<user>:<password>@<host>:5432/brokerverse?uselibpqcompat=true&sslmode=require

# Two different random values of at least 32 characters each (openssl rand -hex 32).
# Keep DATA_ENCRYPTION_KEY with the database backups.
JWT_SECRET=<random-64-hex>
DATA_ENCRYPTION_KEY=<another-random-64-hex>

# Key of the personal identifiers encrypted at rest (TIN, government ID and bank account numbers): a third random value
# of at least 32 characters. Keep it with the database backups: without it those identifiers cannot be read.
# PII_ENCRYPTION_KEY_PREVIOUS is set only during a key rotation (deploy/REFERENCE.md, "Rotating the personal data key").
PII_ENCRYPTION_KEY=<third-random-64-hex>

# First password of the built-in administrator "BrokerVerse" (used only when the account is created).
ADMIN_PASSWORD=<first-administrator-password>

# The front-end address and the public address of the API. These hosts are separate, so the browser calls the API cross-origin.
CORS_ORIGINS=https://brokerverse-demo.inxtuniverse.com
PUBLIC_BASE_URL=https://brokerverse-demo-api.inxtuniverse.com

# Documents, photos and generated reports on the EC2 host.
UPLOAD_DIR=/home/ubuntu/appdata/brokerverse/uploads

# E-mail for quote approvals, password reset codes and reminders: Office 365, port 587 with STARTTLS.
# Write the @ of the user name as %40 and URL-encode any special character in the password.
SMTP_URL=smtp://connect%40iortatechnxt.com:<mailbox-password>@smtp.office365.com:587

# Reference data only in production (no demo leads, policies or users).
SEED_SAMPLE_DATA=false
# Scheduled jobs (renewal notices, ageing, reports, housekeeping). Safe on several instances.
SCHEDULER_ENABLED=true
LOG_LEVEL=info
# Environment name reported by GET /api/version and printed on exported workbooks: Dev, SIT, UAT, Pre-Prod or Production.
# (The commit and build time come from the release artefact, build-info.json, or GIT_COMMIT / BUILD_TIME.)
APP_ENVIRONMENT=Production
