{
  "feature_id": "H7",
  "feature_name": "Lapse Management",
  "description": "Manage lapsed policies, implement win-back strategies, and track reinstatement efforts",
  "mvp_scope": {
    "included": [
      "Lapsed policy tracking",
      "Lapse reason analysis",
      "Win-back campaigns",
      "Reinstatement processing",
      "Grace period management",
      "Lapse prevention alerts"
    ],
    "excluded": [
      "Automated reinstatement",
      "Complex underwriting for reinstatement",
      "Legal recovery processes",
      "Third-party collection integration"
    ]
  },
  "screens": {
    "lapse_dashboard": {
      "name": "Lapse Management Dashboard",
      "purpose": "Monitor and manage lapsed and lapsing policies",
      "navigation": "/renewal/lapse-management",
      "components": {
        "lapse_metrics": {
          "cards": [
            {
              "title": "Lapsing Soon",
              "count": 45,
              "value": "PHP 3.2M",
              "period": "Next 30 days",
              "trend": "warning"
            },
            {
              "title": "In Grace Period",
              "count": 28,
              "value": "PHP 1.8M",
              "remaining_days": "Avg 8 days",
              "trend": "critical"
            },
            {
              "title": "Recently Lapsed",
              "count": 73,
              "value": "PHP 5.4M",
              "period": "Last 30 days",
              "trend": "down"
            },
            {
              "title": "Win-back Success",
              "rate": "22%",
              "recovered": "PHP 1.2M",
              "period": "YTD",
              "trend": "up"
            }
          ]
        },
        "lapse_categories": {
          "type": "tabbed_view",
          "tabs": [
            {
              "name": "Grace Period",
              "description": "Policies in grace period requiring immediate action",
              "priority": "critical",
              "grid_columns": [
                "Policy Number",
                "Insured Name",
                "Product",
                "Premium Due",
                "Days in Grace",
                "Days Remaining",
                "Contact Attempts",
                "Agent",
                "Actions"
              ]
            },
            {
              "name": "Pre-Lapse Alert",
              "description": "Policies approaching lapse date",
              "priority": "high",
              "grid_columns": [
                "Policy Number",
                "Insured Name",
                "Due Date",
                "Premium",
                "Payment History",
                "Risk Score",
                "Last Contact",
                "Actions"
              ]
            },
            {
              "name": "Lapsed",
              "description": "Policies that have lapsed",
              "priority": "medium",
              "grid_columns": [
                "Policy Number",
                "Insured Name",
                "Lapse Date",
                "Premium Lost",
                "Lapse Reason",
                "Win-back Status",
                "Reinstatement Eligible",
                "Actions"
              ]
            }
          ]
        },
        "quick_actions": {
          "grace_period": [
            "Send Urgent Reminder",
            "Call Client",
            "Offer Payment Plan",
            "Extend Grace Period"
          ],
          "pre_lapse": [
            "Send Reminder",
            "Schedule Call",
            "Apply Retention Offer",
            "Flag for Manager"
          ],
          "lapsed": [
            "Initiate Win-back",
            "Check Reinstatement Eligibility",
            "Send Win-back Offer",
            "Close Case"
          ]
        }
      }
    },
    "lapse_analysis": {
      "name": "Lapse Reason Analysis",
      "purpose": "Analyze reasons for policy lapses and identify patterns",
      "navigation": "/renewal/lapse-analysis",
      "components": {
        "reason_breakdown": {
          "type": "pie_chart",
          "categories": [
            "Premium Increase",
            "Financial Difficulty",
            "Switched to Competitor",
            "No Longer Needed",
            "Poor Service",
            "Claims Experience",
            "Other"
          ]
        },
        "trend_analysis": {
          "charts": [
            {
              "type": "line_chart",
              "title": "Lapse Rate Trend",
              "period": "Last 12 months",
              "lines": ["Lapse Rate", "Target", "Industry Average"]
            },
            {
              "type": "bar_chart",
              "title": "Lapses by Product Line",
              "categories": ["Motor", "Fire", "Health", "Personal Accident"],
              "comparison": "vs Previous Year"
            }
          ]
        },
        "detailed_reasons": {
          "type": "data_grid",
          "columns": [
            "Reason Category",
            "Count",
            "Premium Value",
            "Avg Policy Age",
            "Recovery Rate",
            "Action Plan"
          ],
          "drill_down": true,
          "export": ["PDF", "Excel"]
        }
      }
    },
    "win_back_campaigns": {
      "name": "Win-back Campaign Manager",
      "purpose": "Create and manage targeted win-back campaigns",
      "navigation": "/renewal/win-back",
      "components": {
        "campaign_creator": {
          "fields": [
            {"field": "campaign_name", "type": "text", "required": true},
            {"field": "target_segment", "type": "dropdown", "options": ["Recent Lapses", "High Value", "Long Tenure", "Custom"]},
            {"field": "offer_type", "type": "multiselect", "options": ["Discount", "Enhanced Coverage", "Flexible Payment", "Loyalty Bonus"]},
            {"field": "validity_period", "type": "date_range"},
            {"field": "communication_channels", "type": "multiselect", "options": ["Email", "SMS", "Phone", "Letter"]}
          ]
        },
        "campaign_templates": {
          "templates": [
            {
              "name": "Premium Relief",
              "description": "Discount offer for financial hardship cases",
              "offer": "20% discount for 6 months",
              "target": "Financial difficulty lapses"
            },
            {
              "name": "Welcome Back",
              "description": "Special offer for long-term clients",
              "offer": "Waived reinstatement fee + 10% discount",
              "target": "Clients with 3+ years history"
            },
            {
              "name": "Competitor Match",
              "description": "Match competitor pricing",
              "offer": "Price match + additional benefits",
              "target": "Switched to competitor"
            }
          ]
        },
        "active_campaigns": {
          "columns": [
            "Campaign Name",
            "Start Date",
            "Target Audience",
            "Sent",
            "Responded",
            "Converted",
            "Success Rate",
            "Revenue Recovered",
            "Status"
          ],
          "actions": [
            "View Details",
            "Edit Campaign",
            "Send Reminder",
            "End Campaign",
            "Export Results"
          ]
        }
      }
    },
    "reinstatement_processing": {
      "name": "Reinstatement Processing",
      "purpose": "Process policy reinstatements for eligible lapsed policies",
      "navigation": "/renewal/reinstatement",
      "components": {
        "eligibility_checker": {
          "criteria": [
            {"rule": "Lapsed within 90 days", "mandatory": true},
            {"rule": "No claims during lapse period", "mandatory": true},
            {"rule": "Previous payment history", "evaluation": "Good/Fair/Poor"},
            {"rule": "Outstanding premium paid", "mandatory": true},
            {"rule": "Updated documents provided", "required": true}
          ]
        },
        "reinstatement_form": {
          "sections": [
            {
              "name": "Policy Information",
              "fields": ["Policy Number", "Original Expiry", "Lapse Date", "Original Premium"]
            },
            {
              "name": "Reinstatement Terms",
              "fields": [
                {"field": "reinstatement_date", "type": "date", "default": "today"},
                {"field": "premium_adjustment", "type": "percentage", "requires_approval": true},
                {"field": "payment_method", "type": "dropdown"},
                {"field": "special_conditions", "type": "textarea"}
              ]
            },
            {
              "name": "Documentation",
              "requirements": [
                "No-claim declaration",
                "Updated risk information",
                "Payment proof",
                "Reinstatement request letter"
              ]
            }
          ]
        },
        "approval_workflow": {
          "steps": [
            "Agent Submission",
            "Document Verification",
            "Underwriting Review (if required)",
            "Manager Approval",
            "Policy Activation"
          ]
        }
      }
    }
  },
  "data_model": {
    "lapsed_policy": {
      "policy_id": "string",
      "lapse_date": "date",
      "lapse_reason": "enum",
      "premium_lost": "number",
      "grace_period_end": "date",
      "reinstatement_eligible": "boolean",
      "win_back_attempts": "number",
      "final_status": "enum"
    },
    "win_back_campaign": {
      "campaign_id": "string",
      "campaign_name": "string",
      "target_policies": "array",
      "offer_details": "json",
      "start_date": "date",
      "end_date": "date",
      "responses": "number",
      "conversions": "number",
      "revenue_recovered": "number"
    },
    "reinstatement": {
      "reinstatement_id": "string",
      "policy_id": "string",
      "request_date": "date",
      "eligibility_status": "boolean",
      "terms": "json",
      "approval_status": "enum",
      "effective_date": "date"
    }
  },
  "business_rules": [
    "Grace period standard is 30 days, extendable to 60 days with approval",
    "Policies lapsed over 90 days require new application",
    "Win-back offers cannot exceed 25% discount without senior approval",
    "Reinstatement requires full payment of outstanding premiums",
    "Lapse reasons must be documented for all lapsed policies",
    "High-value policies (>PHP 100K) get priority in win-back efforts"
  ]
}