{
  "feature_id": "H10",
  "feature_name": "Renewal Performance Tracking",
  "description": "Comprehensive performance tracking system for renewal operations, team productivity, and success metrics",
  "mvp_scope": {
    "included": [
      "KPI dashboards",
      "Team performance metrics",
      "Individual scorecards",
      "Renewal cycle time tracking",
      "Success rate analysis",
      "Benchmarking and targets"
    ],
    "excluded": [
      "Real-time performance alerts",
      "Predictive performance modeling",
      "Complex compensation calculations",
      "Third-party benchmark data"
    ]
  },
  "screens": {
    "executive_dashboard": {
      "name": "Renewal Performance Executive Dashboard",
      "purpose": "High-level overview of renewal performance for management",
      "navigation": "/renewal/performance/executive",
      "components": {
        "key_metrics": {
          "cards": [
            {
              "title": "Renewal Rate",
              "value": "82.5%",
              "target": "85%",
              "ytd": "83.2%",
              "status": "warning"
            },
            {
              "title": "Revenue Retention",
              "value": "PHP 125.4M",
              "target": "PHP 130M",
              "ytd": "PHP 458.2M",
              "status": "on-track"
            },
            {
              "title": "Avg Cycle Time",
              "value": "18 days",
              "target": "15 days",
              "improvement": "-3 days",
              "status": "improving"
            },
            {
              "title": "Customer Satisfaction",
              "value": "4.2/5",
              "target": "4.5/5",
              "responses": "324",
              "status": "needs-attention"
            }
          ]
        },
        "performance_trends": {
          "charts": [
            {
              "type": "combo_chart",
              "title": "Renewal Performance Trend",
              "metrics": ["Renewal Rate", "Revenue Retention", "Target"],
              "period": "Monthly",
              "range": "Last 12 months"
            },
            {
              "type": "gauge_charts",
              "title": "Current Quarter Performance",
              "gauges": [
                {"metric": "Policy Renewal", "current": 82, "target": 85},
                {"metric": "Premium Retention", "current": 88, "target": 90},
                {"metric": "On-time Processing", "current": 75, "target": 95}
              ]
            }
          ]
        },
        "regional_breakdown": {
          "type": "map_visualization",
          "metrics": ["Renewal Rate", "Revenue", "Policies"],
          "regions": ["NCR", "Luzon", "Visayas", "Mindanao"],
          "drill_down": true
        }
      }
    },
    "team_performance": {
      "name": "Team Performance Dashboard",
      "purpose": "Track and compare team-level renewal performance",
      "navigation": "/renewal/performance/team",
      "components": {
        "team_comparison": {
          "type": "comparison_grid",
          "columns": [
            "Team/Branch",
            "Policies Due",
            "Renewed",
            "Renewal Rate",
            "Revenue Retained",
            "Avg Discount",
            "Cycle Time",
            "Productivity Score",
            "Ranking"
          ],
          "features": [
            "sortable",
            "filterable",
            "color_coded_performance",
            "export_enabled"
          ]
        },
        "team_leaderboard": {
          "categories": [
            {"title": "Highest Renewal Rate", "metric": "percentage"},
            {"title": "Most Revenue Retained", "metric": "amount"},
            {"title": "Fastest Processing", "metric": "days"},
            {"title": "Best Customer Satisfaction", "metric": "score"}
          ],
          "period_selector": ["Week", "Month", "Quarter", "Year"]
        },
        "productivity_metrics": {
          "metrics": [
            {
              "name": "Policies per Agent",
              "calculation": "Renewed Policies / Active Agents",
              "benchmark": "Industry Average"
            },
            {
              "name": "Revenue per Agent",
              "calculation": "Revenue Retained / Active Agents",
              "benchmark": "Company Target"
            },
            {
              "name": "Efficiency Ratio",
              "calculation": "Successful Renewals / Total Attempts",
              "benchmark": "Best Practice"
            }
          ]
        }
      }
    },
    "individual_scorecard": {
      "name": "Individual Agent Scorecard",
      "purpose": "Detailed performance view for individual agents",
      "navigation": "/renewal/performance/agent/:id",
      "components": {
        "agent_summary": {
          "info": [
            "Agent Name",
            "Team/Branch",
            "Role",
            "Tenure"
          ],
          "current_performance": {
            "period": "Current Month",
            "metrics": [
              {"label": "Policies Renewed", "value": 42, "target": 45},
              {"label": "Renewal Rate", "value": "84%", "target": "85%"},
              {"label": "Revenue Retained", "value": "PHP 2.3M", "target": "PHP 2.5M"},
              {"label": "Avg Cycle Time", "value": "16 days", "target": "15 days"}
            ]
          }
        },
        "performance_history": {
          "type": "line_chart",
          "title": "12-Month Performance Trend",
          "metrics": ["Renewal Rate", "Target Achievement", "Team Average"],
          "period": "Monthly"
        },
        "detailed_metrics": {
          "sections": [
            {
              "title": "Efficiency Metrics",
              "items": [
                "First Contact Success Rate",
                "Quote-to-Renewal Conversion",
                "Average Attempts per Renewal",
                "Documentation Accuracy"
              ]
            },
            {
              "title": "Quality Metrics",
              "items": [
                "Customer Satisfaction Score",
                "Error Rate",
                "Compliance Score",
                "Escalation Rate"
              ]
            },
            {
              "title": "Activity Metrics",
              "items": [
                "Calls Made",
                "Emails Sent",
                "Meetings Conducted",
                "Quotes Generated"
              ]
            }
          ]
        },
        "strengths_improvements": {
          "strengths": [
            "High customer satisfaction",
            "Quick response time",
            "Good negotiation skills"
          ],
          "improvements": [
            "Documentation completeness",
            "Follow-up consistency",
            "System utilization"
          ],
          "action_plan": "text"
        }
      }
    },
    "analytics_insights": {
      "name": "Renewal Analytics & Insights",
      "purpose": "Deep dive analytics and actionable insights",
      "navigation": "/renewal/performance/analytics",
      "components": {
        "predictive_analytics": {
          "models": [
            {
              "name": "Renewal Probability",
              "description": "Likelihood of policy renewal based on historical patterns",
              "accuracy": "78%"
            },
            {
              "name": "Optimal Contact Time",
              "description": "Best time to contact clients for renewal",
              "impact": "+12% success rate"
            }
          ]
        },
        "cohort_analysis": {
          "type": "heatmap",
          "title": "Renewal Rate by Cohort",
          "dimensions": ["Policy Start Month", "Renewal Number"],
          "metric": "Renewal Rate",
          "insights": [
            "First renewal has lowest retention",
            "3+ renewals show 90%+ retention",
            "Q4 policies have higher renewal rates"
          ]
        },
        "factor_analysis": {
          "title": "Key Factors Affecting Renewal",
          "factors": [
            {"factor": "Price Change", "impact": -0.65, "significance": "High"},
            {"factor": "Claims Experience", "impact": -0.45, "significance": "Medium"},
            {"factor": "Agent Relationship", "impact": 0.55, "significance": "High"},
            {"factor": "Payment History", "impact": 0.35, "significance": "Medium"},
            {"factor": "Policy Age", "impact": 0.25, "significance": "Low"}
          ]
        },
        "recommendations": {
          "type": "action_cards",
          "items": [
            {
              "title": "Focus on First Renewals",
              "description": "First renewal rate is 15% below average",
              "action": "Implement special first renewal program",
              "impact": "Could improve overall rate by 3%"
            },
            {
              "title": "Optimize Contact Timing",
              "description": "60-day advance contact shows best results",
              "action": "Adjust contact schedule",
              "impact": "Expected 5% improvement in success rate"
            }
          ]
        }
      }
    }
  },
  "data_model": {
    "performance_metric": {
      "metric_id": "string",
      "agent_id": "string",
      "team_id": "string",
      "period": "string",
      "renewal_rate": "percentage",
      "policies_renewed": "number",
      "revenue_retained": "number",
      "avg_cycle_time": "days",
      "customer_satisfaction": "number",
      "productivity_score": "number"
    },
    "performance_target": {
      "target_id": "string",
      "entity_type": "enum", // agent, team, branch, company
      "entity_id": "string",
      "metric": "string",
      "target_value": "number",
      "period": "string",
      "status": "enum"
    },
    "performance_insight": {
      "insight_id": "string",
      "type": "enum",
      "description": "text",
      "impact": "text",
      "recommendation": "text",
      "priority": "enum",
      "date_identified": "date"
    }
  },
  "business_rules": [
    "Performance metrics calculated daily, aggregated weekly/monthly",
    "Individual targets based on role, experience, and territory",
    "Minimum activity thresholds required for performance evaluation",
    "Customer satisfaction surveys sent 7 days after renewal",
    "Performance rankings updated real-time, published monthly",
    "Underperformance triggers coaching plan after 2 consecutive months"
  ]
}