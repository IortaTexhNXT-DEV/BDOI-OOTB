{
  "remittance_user_transactions_k13_k17": {
    "k13_direct_bill_processing": {
      "featureId": "K13-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Direct Bill Processing",
      "screenCode": "FIN_TRN_REM_013",
      "menuPath": "Finance > Remittance > Direct Bill > Process Direct Bills",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "headerSection": {
        "layout": "five-column",
        "fields": [
          {
            "fieldName": "Bill Run No",
            "fieldId": "billRunNo",
            "type": "text",
            "readonly": true,
            "autoGenerated": true,
            "format": "DBR-{YYYY}-{00000}",
            "width": "20%"
          },
          {
            "fieldName": "Bill Period",
            "fieldId": "billPeriod",
            "type": "month-picker",
            "required": true,
            "defaultValue": "currentMonth",
            "width": "20%"
          },
          {
            "fieldName": "Bill Date",
            "fieldId": "billDate",
            "type": "date",
            "required": true,
            "defaultValue": "currentDate",
            "width": "20%"
          },
          {
            "fieldName": "Due Date",
            "fieldId": "dueDate",
            "type": "date",
            "required": true,
            "calculated": "billDate+30days",
            "width": "20%"
          },
          {
            "fieldName": "Status",
            "fieldId": "status",
            "type": "text",
            "readonly": true,
            "defaultValue": "Draft",
            "statusColor": true,
            "width": "20%"
          }
        ]
      },
      "mainSection": {
        "layout": "wizard-tabs",
        "tabs": [
          {
            "tabId": "selection",
            "tabLabel": "1. Select Policies",
            "sections": [
              {
                "filterSection": {
                  "layout": "horizontal",
                  "fields": [
                    {
                      "fieldName": "Insurer",
                      "fieldId": "insurer",
                      "type": "dropdown",
                      "source": "directBillInsurers",
                      "required": true,
                      "width": "30%"
                    },
                    {
                      "fieldName": "Product Line",
                      "fieldId": "productLine",
                      "type": "multiselect",
                      "options": ["Motor", "Health", "Life", "Property"],
                      "width": "30%"
                    },
                    {
                      "fieldName": "Policy Status",
                      "fieldId": "policyStatus",
                      "type": "dropdown",
                      "options": ["Active", "Grace Period", "All"],
                      "defaultValue": "Active",
                      "width": "20%"
                    },
                    {
                      "buttons": [
                        {
                          "label": "Load Policies",
                          "action": "loadPolicies",
                          "type": "primary"
                        }
                      ],
                      "width": "20%"
                    }
                  ]
                },
                "policyGrid": {
                  "columns": [
                    {
                      "field": "select",
                      "type": "checkbox",
                      "width": "5%"
                    },
                    {
                      "field": "policyNo",
                      "header": "Policy No",
                      "width": "12%"
                    },
                    {
                      "field": "insuredName",
                      "header": "Insured Name",
                      "width": "18%"
                    },
                    {
                      "field": "product",
                      "header": "Product",
                      "width": "10%"
                    },
                    {
                      "field": "effectiveDate",
                      "header": "Effective Date",
                      "width": "10%",
                      "format": "date"
                    },
                    {
                      "field": "premium",
                      "header": "Premium",
                      "width": "12%",
                      "align": "right",
                      "format": "currency"
                    },
                    {
                      "field": "outstandingAmount",
                      "header": "Outstanding",
                      "width": "12%",
                      "align": "right",
                      "format": "currency"
                    },
                    {
                      "field": "lastPaymentDate",
                      "header": "Last Payment",
                      "width": "10%",
                      "format": "date"
                    },
                    {
                      "field": "billAmount",
                      "header": "Bill Amount",
                      "width": "11%",
                      "align": "right",
                      "format": "currency",
                      "editable": true
                    }
                  ],
                  "features": {
                    "selectAll": true,
                    "editable": true,
                    "showSelectedSummary": true
                  }
                }
              }
            ]
          },
          {
            "tabId": "billDetails",
            "tabLabel": "2. Bill Details",
            "sections": [
              {
                "summaryCards": {
                  "layout": "horizontal",
                  "cards": [
                    {
                      "title": "Total Policies",
                      "value": "policyCount",
                      "icon": "document"
                    },
                    {
                      "title": "Total Premium",
                      "value": "totalPremium",
                      "format": "currency",
                      "icon": "dollar"
                    },
                    {
                      "title": "Previous Balance",
                      "value": "previousBalance",
                      "format": "currency",
                      "icon": "history"
                    },
                    {
                      "title": "Total Bill Amount",
                      "value": "totalBillAmount",
                      "format": "currency",
                      "icon": "calculator",
                      "highlight": true
                    }
                  ]
                },
                "insuredBills": {
                  "sectionTitle": "Insured-wise Bills",
                  "type": "grouped-grid",
                  "groupBy": "insuredName",
                  "columns": [
                    {
                      "field": "insuredCode",
                      "header": "Insured Code",
                      "width": "10%"
                    },
                    {
                      "field": "insuredName",
                      "header": "Insured Name",
                      "width": "20%"
                    },
                    {
                      "field": "email",
                      "header": "Email",
                      "width": "15%"
                    },
                    {
                      "field": "policyCount",
                      "header": "Policies",
                      "width": "8%",
                      "align": "center"
                    },
                    {
                      "field": "currentPremium",
                      "header": "Current Premium",
                      "width": "12%",
                      "align": "right",
                      "format": "currency"
                    },
                    {
                      "field": "previousDue",
                      "header": "Previous Due",
                      "width": "12%",
                      "align": "right",
                      "format": "currency"
                    },
                    {
                      "field": "totalDue",
                      "header": "Total Due",
                      "width": "13%",
                      "align": "right",
                      "format": "currency",
                      "bold": true
                    },
                    {
                      "field": "actions",
                      "header": "Actions",
                      "width": "10%",
                      "type": "action-buttons",
                      "actions": [
                        {"icon": "edit", "tooltip": "Edit", "action": "edit"},
                        {"icon": "view", "tooltip": "View Details", "action": "viewDetails"}
                      ]
                    }
                  ],
                  "expandableContent": {
                    "showPolicies": true,
                    "policyColumns": [
                      {"field": "policyNo", "header": "Policy No"},
                      {"field": "product", "header": "Product"},
                      {"field": "premium", "header": "Premium", "format": "currency"}
                    ]
                  }
                }
              }
            ]
          },
          {
            "tabId": "charges",
            "tabLabel": "3. Late Charges",
            "sections": [
              {
                "lateChargeCalculation": {
                  "sectionTitle": "Late Charge Calculation",
                  "layout": "two-column",
                  "fields": [
                    {
                      "fieldName": "Apply Late Charges",
                      "fieldId": "applyLateCharges",
                      "type": "checkbox",
                      "defaultValue": false,
                      "width": "50%"
                    },
                    {
                      "fieldName": "Late Charge Method",
                      "fieldId": "lateChargeMethod",
                      "type": "dropdown",
                      "options": ["Flat Amount", "Percentage", "Slab-based"],
                      "conditional": "applyLateCharges=true",
                      "width": "50%"
                    }
                  ]
                },
                "overduePolicies": {
                  "sectionTitle": "Overdue Policies",
                  "conditional": "applyLateCharges=true",
                  "type": "editable-grid",
                  "columns": [
                    {
                      "field": "policyNo",
                      "header": "Policy No",
                      "width": "15%"
                    },
                    {
                      "field": "insuredName",
                      "header": "Insured",
                      "width": "20%"
                    },
                    {
                      "field": "overdueAmount",
                      "header": "Overdue Amount",
                      "width": "15%",
                      "align": "right",
                      "format": "currency"
                    },
                    {
                      "field": "overdueDays",
                      "header": "Days Overdue",
                      "width": "10%",
                      "align": "center"
                    },
                    {
                      "field": "lateChargeRate",
                      "header": "Rate/Amount",
                      "width": "12%",
                      "editable": true
                    },
                    {
                      "field": "lateCharge",
                      "header": "Late Charge",
                      "width": "13%",
                      "align": "right",
                      "format": "currency",
                      "calculated": true
                    },
                    {
                      "field": "waive",
                      "header": "Waive",
                      "width": "8%",
                      "type": "checkbox",
                      "editable": true
                    },
                    {
                      "field": "remarks",
                      "header": "Remarks",
                      "width": "7%",
                      "type": "text",
                      "editable": true
                    }
                  ]
                }
              }
            ]
          },
          {
            "tabId": "generate",
            "tabLabel": "4. Generate Bills",
            "sections": [
              {
                "billGeneration": {
                  "sectionTitle": "Bill Generation Options",
                  "layout": "two-column",
                  "fields": [
                    {
                      "fieldName": "Bill Format",
                      "fieldId": "billFormat",
                      "type": "dropdown",
                      "options": ["Standard", "Detailed", "Summary"],
                      "defaultValue": "Standard",
                      "width": "50%"
                    },
                    {
                      "fieldName": "Delivery Method",
                      "fieldId": "deliveryMethod",
                      "type": "checkbox-group",
                      "options": [
                        {"value": "email", "label": "Email", "checked": true},
                        {"value": "print", "label": "Print"},
                        {"value": "portal", "label": "Customer Portal"}
                      ],
                      "width": "50%"
                    },
                    {
                      "fieldName": "Include Statement",
                      "fieldId": "includeStatement",
                      "type": "checkbox",
                      "defaultValue": true,
                      "width": "50%"
                    },
                    {
                      "fieldName": "Create GL Entries",
                      "fieldId": "createGLEntries",
                      "type": "checkbox",
                      "defaultValue": true,
                      "width": "50%"
                    }
                  ]
                },
                "finalSummary": {
                  "sectionTitle": "Final Summary",
                  "type": "summary-table",
                  "rows": [
                    {"label": "Total Policies", "value": "totalPolicies", "format": "number"},
                    {"label": "Total Premium", "value": "totalPremium", "format": "currency"},
                    {"label": "Previous Balance", "value": "previousBalance", "format": "currency"},
                    {"label": "Late Charges", "value": "totalLateCharges", "format": "currency"},
                    {"label": "Adjustments", "value": "adjustments", "format": "currency"},
                    {"separator": true},
                    {"label": "Total Bill Amount", "value": "finalBillAmount", "format": "currency", "bold": true, "highlight": true},
                    {"separator": true},
                    {"label": "Bills to Generate", "value": "billCount", "format": "number"},
                    {"label": "Emails to Send", "value": "emailCount", "format": "number"}
                  ]
                }
              }
            ]
          }
        ]
      },
      "actionButtons": {
        "position": "bottom-right",
        "buttons": [
          {
            "label": "Previous",
            "action": "previousTab",
            "type": "secondary",
            "conditional": "currentTab>1"
          },
          {
            "label": "Next",
            "action": "nextTab",
            "type": "primary",
            "conditional": "currentTab<4"
          },
          {
            "label": "Save Draft",
            "action": "saveDraft",
            "type": "secondary"
          },
          {
            "label": "Generate Bills",
            "action": "generateBills",
            "type": "success",
            "conditional": "currentTab=4",
            "requireValidation": true,
            "confirmation": true
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "type": "link"
          }
        ]
      }
    },
    "k14_remittance_adjustments": {
      "featureId": "K14-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Remittance Adjustments",
      "screenCode": "FIN_TRN_REM_014",
      "menuPath": "Finance > Remittance > Adjustments > Create Adjustment",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "headerSection": {
        "layout": "four-column",
        "fields": [
          {
            "fieldName": "Adjustment No",
            "fieldId": "adjustmentNo",
            "type": "text",
            "readonly": true,
            "autoGenerated": true,
            "format": "ADJ-{YYYY}-{00000}",
            "width": "25%"
          },
          {
            "fieldName": "Adjustment Date",
            "fieldId": "adjustmentDate",
            "type": "date",
            "required": true,
            "defaultValue": "currentDate",
            "width": "25%"
          },
          {
            "fieldName": "Adjustment Type",
            "fieldId": "adjustmentType",
            "type": "dropdown",
            "source": "adjustmentTypeMaster",
            "required": true,
            "onChange": "loadAdjustmentDetails",
            "width": "25%"
          },
          {
            "fieldName": "Status",
            "fieldId": "status",
            "type": "text",
            "readonly": true,
            "defaultValue": "Draft",
            "statusColor": true,
            "width": "25%"
          }
        ]
      },
      "mainSection": {
        "layout": "two-panel",
        "leftPanel": {
          "title": "Adjustment Details",
          "width": "60%",
          "sections": [
            {
              "sectionTitle": "Source Transaction",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Transaction Type",
                  "fieldId": "transactionType",
                  "type": "dropdown",
                  "options": ["Remittance", "Settlement", "Direct Bill", "Agency Bill"],
                  "required": true,
                  "onChange": "clearTransaction",
                  "width": "50%"
                },
                {
                  "fieldName": "Transaction No",
                  "fieldId": "transactionNo",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "lookupSource": "based_on_transactionType",
                  "onChange": "loadTransactionDetails",
                  "width": "50%"
                }
              ]
            },
            {
              "sectionTitle": "Transaction Summary",
              "layout": "info-display",
              "conditional": "transactionNo",
              "fields": [
                {"label": "Insurer", "value": "insurerName"},
                {"label": "Transaction Date", "value": "transactionDate", "format": "date"},
                {"label": "Original Amount", "value": "originalAmount", "format": "currency"},
                {"label": "Current Balance", "value": "currentBalance", "format": "currency"}
              ]
            },
            {
              "sectionTitle": "Adjustment Information",
              "layout": "single-column",
              "fields": [
                {
                  "fieldName": "Adjustment Category",
                  "fieldId": "adjustmentCategory",
                  "type": "dropdown",
                  "options": ["Premium", "Commission", "Tax", "Fee", "Penalty", "Refund"],
                  "required": true
                },
                {
                  "fieldName": "Adjustment Nature",
                  "fieldId": "adjustmentNature",
                  "type": "radio-group",
                  "options": [
                    {"value": "debit", "label": "Debit (Add to Balance)"},
                    {"value": "credit", "label": "Credit (Reduce Balance)"}
                  ],
                  "required": true
                },
                {
                  "fieldName": "Adjustment Amount",
                  "fieldId": "adjustmentAmount",
                  "type": "decimal",
                  "required": true,
                  "min": 0.01,
                  "format": "currency",
                  "validation": "checkLimits"
                },
                {
                  "fieldName": "Reason Code",
                  "fieldId": "reasonCode",
                  "type": "dropdown",
                  "source": "adjustmentReasons",
                  "required": true
                },
                {
                  "fieldName": "Detailed Reason",
                  "fieldId": "detailedReason",
                  "type": "textarea",
                  "rows": 3,
                  "required": true,
                  "maxLength": 500
                }
              ]
            }
          ]
        },
        "rightPanel": {
          "title": "Impact Analysis",
          "width": "40%",
          "sections": [
            {
              "sectionTitle": "Financial Impact",
              "type": "impact-display",
              "fields": [
                {"label": "Original Amount", "value": "originalAmount", "format": "currency"},
                {"label": "Adjustment", "value": "adjustmentAmount", "format": "currency", "sign": true},
                {"separator": true},
                {"label": "New Balance", "value": "newBalance", "format": "currency", "bold": true, "calculated": true}
              ]
            },
            {
              "sectionTitle": "GL Impact",
              "type": "gl-entries-preview",
              "entries": [
                {
                  "account": "dynamic_based_on_adjustment",
                  "debit": "conditional",
                  "credit": "conditional"
                }
              ]
            },
            {
              "sectionTitle": "Approval Required",
              "conditional": "adjustmentAmount>userLimit",
              "type": "approval-info",
              "fields": [
                {"label": "Your Limit", "value": "userLimit", "format": "currency"},
                {"label": "Required Approver", "value": "requiredApprover"},
                {"label": "Approval Status", "value": "approvalStatus", "type": "status-badge"}
              ]
            },
            {
              "sectionTitle": "Supporting Documents",
              "fields": [
                {
                  "fieldName": "Attachments",
                  "fieldId": "attachments",
                  "type": "file-upload",
                  "multiple": true,
                  "accept": ".pdf,.jpg,.png,.doc,.xlsx",
                  "maxSize": "5MB",
                  "required": false
                }
              ]
            }
          ]
        }
      },
      "actionButtons": {
        "position": "bottom-right",
        "buttons": [
          {
            "label": "Save Draft",
            "action": "saveDraft",
            "type": "secondary"
          },
          {
            "label": "Submit for Approval",
            "action": "submitApproval",
            "type": "primary",
            "conditional": "requiresApproval",
            "requireValidation": true
          },
          {
            "label": "Process Adjustment",
            "action": "processAdjustment",
            "type": "success",
            "conditional": "!requiresApproval||approved",
            "requireValidation": true,
            "confirmation": true
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "type": "link"
          }
        ]
      }
    },
    "k15_remittance_notifications": {
      "featureId": "K15-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Remittance Notifications",
      "screenCode": "FIN_TRN_REM_015",
      "menuPath": "Finance > Remittance > Notifications > Manage Notifications",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "dashboardSection": {
        "layout": "notification-stats",
        "cards": [
          {
            "title": "Sent Today",
            "value": "sentToday",
            "icon": "send",
            "color": "blue"
          },
          {
            "title": "Pending",
            "value": "pendingCount",
            "icon": "clock",
            "color": "orange"
          },
          {
            "title": "Failed",
            "value": "failedCount",
            "icon": "error",
            "color": "red"
          },
          {
            "title": "Scheduled",
            "value": "scheduledCount",
            "icon": "calendar",
            "color": "green"
          }
        ]
      },
      "mainSection": {
        "layout": "tabbed-view",
        "tabs": [
          {
            "tabId": "send",
            "tabLabel": "Send Notification",
            "sections": [
              {
                "recipientSelection": {
                  "sectionTitle": "Select Recipients",
                  "layout": "two-column",
                  "fields": [
                    {
                      "fieldName": "Recipient Type",
                      "fieldId": "recipientType",
                      "type": "radio-group",
                      "options": [
                        {"value": "specific", "label": "Specific Insurers"},
                        {"value": "group", "label": "Insurer Group"},
                        {"value": "criteria", "label": "Based on Criteria"}
                      ],
                      "defaultValue": "specific",
                      "width": "50%"
                    },
                    {
                      "fieldName": "Select Insurers",
                      "fieldId": "selectedInsurers",
                      "type": "multiselect-with-search",
                      "source": "insurerMaster",
                      "conditional": "recipientType=specific",
                      "width": "50%"
                    },
                    {
                      "fieldName": "Insurer Group",
                      "fieldId": "insurerGroup",
                      "type": "dropdown",
                      "source": "insurerGroups",
                      "conditional": "recipientType=group",
                      "width": "50%"
                    },
                    {
                      "fieldName": "Selection Criteria",
                      "fieldId": "criteria",
                      "type": "criteria-builder",
                      "conditional": "recipientType=criteria",
                      "width": "100%",
                      "options": [
                        "Overdue > X days",
                        "Outstanding > X amount",
                        "Region = X",
                        "Product Line = X"
                      ]
                    }
                  ]
                },
                "notificationContent": {
                  "sectionTitle": "Notification Content",
                  "fields": [
                    {
                      "fieldName": "Notification Type",
                      "fieldId": "notificationType",
                      "type": "dropdown",
                      "source": "notificationTemplates",
                      "required": true,
                      "onChange": "loadTemplate"
                    },
                    {
                      "fieldName": "Channel",
                      "fieldId": "channel",
                      "type": "checkbox-group",
                      "options": [
                        {"value": "email", "label": "Email", "checked": true},
                        {"value": "sms", "label": "SMS"},
                        {"value": "portal", "label": "Portal Notification"}
                      ]
                    },
                    {
                      "fieldName": "Subject",
                      "fieldId": "subject",
                      "type": "text",
                      "required": true,
                      "conditional": "channel.includes(email)"
                    },
                    {
                      "fieldName": "Message",
                      "fieldId": "message",
                      "type": "rich-text-editor",
                      "height": "300px",
                      "conditional": "channel.includes(email)",
                      "variables": [
                        "{{insurerName}}",
                        "{{remittanceNo}}",
                        "{{amount}}",
                        "{{dueDate}}"
                      ]
                    },
                    {
                      "fieldName": "SMS Message",
                      "fieldId": "smsMessage",
                      "type": "textarea",
                      "maxLength": 160,
                      "showCharCount": true,
                      "conditional": "channel.includes(sms)"
                    }
                  ]
                },
                "schedulingOptions": {
                  "sectionTitle": "Scheduling",
                  "layout": "two-column",
                  "fields": [
                    {
                      "fieldName": "Send",
                      "fieldId": "sendTiming",
                      "type": "radio-group",
                      "options": [
                        {"value": "now", "label": "Send Now"},
                        {"value": "schedule", "label": "Schedule for Later"}
                      ],
                      "defaultValue": "now",
                      "width": "50%"
                    },
                    {
                      "fieldName": "Schedule Date/Time",
                      "fieldId": "scheduleDateTime",
                      "type": "datetime",
                      "conditional": "sendTiming=schedule",
                      "minDate": "currentDateTime",
                      "width": "50%"
                    }
                  ]
                }
              }
            ]
          },
          {
            "tabId": "queue",
            "tabLabel": "Notification Queue",
            "sections": [
              {
                "queueGrid": {
                  "columns": [
                    {
                      "field": "notificationId",
                      "header": "ID",
                      "width": "8%"
                    },
                    {
                      "field": "recipientName",
                      "header": "Recipient",
                      "width": "15%"
                    },
                    {
                      "field": "notificationType",
                      "header": "Type",
                      "width": "12%"
                    },
                    {
                      "field": "channel",
                      "header": "Channel",
                      "width": "10%",
                      "type": "tags"
                    },
                    {
                      "field": "scheduledTime",
                      "header": "Scheduled",
                      "width": "15%",
                      "format": "datetime"
                    },
                    {
                      "field": "status",
                      "header": "Status",
                      "width": "10%",
                      "type": "status-badge"
                    },
                    {
                      "field": "attempts",
                      "header": "Attempts",
                      "width": "8%",
                      "align": "center"
                    },
                    {
                      "field": "lastError",
                      "header": "Error",
                      "width": "12%"
                    },
                    {
                      "field": "actions",
                      "header": "Actions",
                      "width": "10%",
                      "type": "action-buttons",
                      "actions": [
                        {"icon": "retry", "tooltip": "Retry", "action": "retry", "conditional": "status=Failed"},
                        {"icon": "cancel", "tooltip": "Cancel", "action": "cancel", "conditional": "status=Pending"},
                        {"icon": "view", "tooltip": "View", "action": "view"}
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "tabId": "history",
            "tabLabel": "Notification History",
            "sections": [
              {
                "historyFilter": {
                  "layout": "horizontal",
                  "fields": [
                    {
                      "fieldName": "Date Range",
                      "fieldId": "dateRange",
                      "type": "date-range",
                      "defaultValue": "last7days",
                      "width": "30%"
                    },
                    {
                      "fieldName": "Status",
                      "fieldId": "status",
                      "type": "dropdown",
                      "options": ["All", "Sent", "Failed", "Bounced"],
                      "defaultValue": "All",
                      "width": "20%"
                    },
                    {
                      "fieldName": "Channel",
                      "fieldId": "channel",
                      "type": "dropdown",
                      "options": ["All", "Email", "SMS", "Portal"],
                      "defaultValue": "All",
                      "width": "20%"
                    }
                  ]
                },
                "historyGrid": {
                  "columns": [
                    {"field": "sentDate", "header": "Sent Date", "width": "15%", "format": "datetime"},
                    {"field": "recipient", "header": "Recipient", "width": "20%"},
                    {"field": "type", "header": "Type", "width": "15%"},
                    {"field": "channel", "header": "Channel", "width": "10%"},
                    {"field": "subject", "header": "Subject/Message", "width": "25%"},
                    {"field": "status", "header": "Status", "width": "10%", "type": "status-badge"},
                    {"field": "actions", "header": "", "width": "5%", "type": "action-buttons", "actions": [{"icon": "view", "action": "view"}]}
                  ]
                }
              }
            ]
          }
        ]
      },
      "actionButtons": {
        "position": "bottom-right",
        "conditional": "currentTab=send",
        "buttons": [
          {
            "label": "Preview",
            "action": "preview",
            "type": "secondary"
          },
          {
            "label": "Send Notification",
            "action": "sendNotification",
            "type": "primary",
            "requireValidation": true
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "type": "link"
          }
        ]
      }
    },
    "k16_remittance_history": {
      "featureId": "K16-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Remittance History",
      "screenCode": "FIN_TRN_REM_016",
      "menuPath": "Finance > Remittance > History > View History",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER", "VIEWER"],
      "note": "Partially implemented - Reports Module exists",
      "searchSection": {
        "layout": "advanced-search",
        "collapsible": false,
        "fields": [
          {
            "fieldName": "Quick Search",
            "fieldId": "quickSearch",
            "type": "text",
            "placeholder": "Search by remittance no, insurer, amount...",
            "width": "40%",
            "icon": "search"
          },
          {
            "fieldName": "Date Range",
            "fieldId": "dateRange",
            "type": "date-range",
            "defaultValue": "last3months",
            "quickOptions": ["Today", "This Week", "This Month", "Last 3 Months", "This Year"],
            "width": "30%"
          },
          {
            "fieldName": "Status",
            "fieldId": "status",
            "type": "multiselect",
            "options": ["Draft", "Pending", "Approved", "Processed", "Completed", "Cancelled"],
            "width": "20%"
          },
          {
            "buttons": [
              {
                "label": "Advanced",
                "action": "toggleAdvanced",
                "type": "link",
                "icon": "filter"
              }
            ],
            "width": "10%"
          }
        ],
        "advancedFields": {
          "conditional": "advancedMode",
          "layout": "three-column",
          "fields": [
            {
              "fieldName": "Insurer",
              "fieldId": "insurer",
              "type": "multiselect",
              "source": "insurerMaster"
            },
            {
              "fieldName": "Amount Range",
              "fieldId": "amountRange",
              "type": "range-input",
              "format": "currency"
            },
            {
              "fieldName": "Transaction Type",
              "fieldId": "transactionType",
              "type": "multiselect",
              "options": ["Settlement", "Direct Bill", "Agency Bill", "Electronic Transfer"]
            }
          ]
        }
      },
      "historyView": {
        "layout": "master-detail",
        "masterSection": {
          "type": "timeline-grid",
          "groupBy": "month",
          "columns": [
            {
              "field": "remittanceNo",
              "header": "Remittance No",
              "width": "12%",
              "type": "link",
              "sticky": true
            },
            {
              "field": "transactionDate",
              "header": "Date",
              "width": "10%",
              "format": "date"
            },
            {
              "field": "insurerCode",
              "header": "Insurer",
              "width": "8%"
            },
            {
              "field": "insurerName",
              "header": "Name",
              "width": "15%"
            },
            {
              "field": "transactionType",
              "header": "Type",
              "width": "10%"
            },
            {
              "field": "policyCount",
              "header": "Policies",
              "width": "8%",
              "align": "center"
            },
            {
              "field": "amount",
              "header": "Amount",
              "width": "12%",
              "align": "right",
              "format": "currency"
            },
            {
              "field": "status",
              "header": "Status",
              "width": "8%",
              "type": "status-badge"
            },
            {
              "field": "processedBy",
              "header": "Processed By",
              "width": "10%"
            },
            {
              "field": "actions",
              "header": "Actions",
              "width": "7%",
              "type": "action-buttons",
              "actions": [
                {"icon": "view", "tooltip": "View", "action": "viewDetails"},
                {"icon": "download", "tooltip": "Download", "action": "download"},
                {"icon": "audit", "tooltip": "Audit Trail", "action": "viewAudit"}
              ]
            }
          ],
          "features": {
            "pagination": true,
            "pageSize": 50,
            "infiniteScroll": true,
            "exportable": true,
            "columnCustomization": true
          }
        },
        "detailSection": {
          "conditional": "hasSelection",
          "type": "sliding-panel",
          "width": "40%",
          "tabs": [
            {
              "tabId": "details",
              "tabLabel": "Details",
              "content": "dynamic_transaction_details"
            },
            {
              "tabId": "audit",
              "tabLabel": "Audit Trail",
              "content": {
                "type": "audit-timeline",
                "entries": [
                  {"action": "Created", "user": "userName", "timestamp": "datetime", "details": "additional info"},
                  {"action": "Updated", "user": "userName", "timestamp": "datetime", "changes": "field changes"},
                  {"action": "Approved", "user": "userName", "timestamp": "datetime"},
                  {"action": "Processed", "user": "userName", "timestamp": "datetime"}
                ]
              }
            },
            {
              "tabId": "documents",
              "tabLabel": "Documents",
              "content": {
                "type": "document-list",
                "documents": "dynamic_attachments"
              }
            }
          ]
        }
      },
      "actionButtons": {
        "position": "top-right",
        "buttons": [
          {
            "label": "Export History",
            "action": "export",
            "type": "secondary",
            "icon": "download"
          },
          {
            "label": "Print Report",
            "action": "print",
            "type": "secondary",
            "icon": "print"
          },
          {
            "label": "Archive",
            "action": "archive",
            "type": "secondary",
            "icon": "archive",
            "requireConfirmation": true
          }
        ]
      }
    },
    "k17_remittance_analytics": {
      "featureId": "K17-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Remittance Analytics Dashboard",
      "screenCode": "FIN_TRN_REM_017",
      "menuPath": "Finance > Remittance > Analytics > Dashboard",
      "accessRoles": ["MANAGER", "FINANCE_HEAD", "EXECUTIVE"],
      "headerSection": {
        "layout": "dashboard-controls",
        "fields": [
          {
            "fieldName": "Dashboard View",
            "fieldId": "dashboardView",
            "type": "dropdown",
            "options": ["Executive", "Operational", "Financial", "Custom"],
            "defaultValue": "Executive",
            "onChange": "switchDashboard",
            "width": "20%"
          },
          {
            "fieldName": "Period",
            "fieldId": "period",
            "type": "date-range",
            "defaultValue": "currentMonth",
            "quickOptions": ["Today", "This Week", "This Month", "This Quarter", "This Year"],
            "width": "25%"
          },
          {
            "fieldName": "Branch",
            "fieldId": "branch",
            "type": "dropdown",
            "source": "branchMaster",
            "defaultValue": "All",
            "width": "15%"
          },
          {
            "fieldName": "Auto Refresh",
            "fieldId": "autoRefresh",
            "type": "toggle",
            "defaultValue": true,
            "width": "10%"
          },
          {
            "buttons": [
              {
                "icon": "refresh",
                "tooltip": "Refresh Now",
                "action": "refresh"
              },
              {
                "icon": "fullscreen",
                "tooltip": "Full Screen",
                "action": "fullscreen"
              },
              {
                "icon": "export",
                "tooltip": "Export Dashboard",
                "action": "export"
              }
            ],
            "width": "30%"
          }
        ]
      },
      "dashboardLayout": {
        "type": "responsive-grid",
        "rows": 4,
        "columns": 6,
        "widgets": [
          {
            "widgetId": "kpi_cards",
            "type": "kpi-card-group",
            "position": {"row": 1, "col": 1, "rowSpan": 1, "colSpan": 6},
            "cards": [
              {
                "title": "Total Remittance",
                "value": "totalRemittance",
                "format": "currency",
                "trend": "+12%",
                "trendPeriod": "vs last month",
                "icon": "trending-up",
                "color": "green"
              },
              {
                "title": "Collection Rate",
                "value": "collectionRate",
                "format": "percentage",
                "trend": "+5%",
                "target": "95%",
                "icon": "target",
                "color": "blue"
              },
              {
                "title": "Avg Processing Time",
                "value": "avgProcessingTime",
                "format": "duration",
                "trend": "-2 days",
                "benchmark": "3 days",
                "icon": "clock",
                "color": "orange"
              },
              {
                "title": "Exception Rate",
                "value": "exceptionRate",
                "format": "percentage",
                "trend": "-3%",
                "threshold": "<5%",
                "icon": "alert",
                "color": "red"
              },
              {
                "title": "Pending Approvals",
                "value": "pendingApprovals",
                "format": "number",
                "urgent": "3",
                "icon": "hourglass",
                "color": "purple",
                "clickable": true
              }
            ]
          },
          {
            "widgetId": "revenue_trend",
            "type": "line-chart",
            "position": {"row": 2, "col": 1, "rowSpan": 1, "colSpan": 4},
            "config": {
              "title": "Revenue Trend",
              "xAxis": "month",
              "yAxis": "amount",
              "series": [
                {"name": "Current Year", "color": "#1e88e5"},
                {"name": "Previous Year", "color": "#d4d4d4"}
              ],
              "showLegend": true,
              "showGrid": true,
              "interactive": true
            }
          },
          {
            "widgetId": "top_insurers",
            "type": "bar-chart",
            "position": {"row": 2, "col": 5, "rowSpan": 1, "colSpan": 2},
            "config": {
              "title": "Top 5 Insurers",
              "orientation": "horizontal",
              "dataKey": "insurerName",
              "valueKey": "amount",
              "color": "gradient",
              "showValues": true
            }
          },
          {
            "widgetId": "payment_status",
            "type": "donut-chart",
            "position": {"row": 3, "col": 1, "rowSpan": 1, "colSpan": 2},
            "config": {
              "title": "Payment Status",
              "centerText": "Total",
              "categories": [
                {"name": "Paid", "color": "#4caf50"},
                {"name": "Pending", "color": "#ff9800"},
                {"name": "Overdue", "color": "#f44336"}
              ],
              "showPercentage": true
            }
          },
          {
            "widgetId": "product_distribution",
            "type": "pie-chart",
            "position": {"row": 3, "col": 3, "rowSpan": 1, "colSpan": 2},
            "config": {
              "title": "Product Distribution",
              "categories": ["Motor", "Health", "Life", "Property"],
              "showLegend": true,
              "interactive": true
            }
          },
          {
            "widgetId": "aging_analysis",
            "type": "stacked-bar",
            "position": {"row": 3, "col": 5, "rowSpan": 1, "colSpan": 2},
            "config": {
              "title": "Aging Analysis",
              "categories": ["0-30", "31-60", "61-90", ">90"],
              "series": ["Current", "Overdue"],
              "colors": ["#4caf50", "#f44336"]
            }
          },
          {
            "widgetId": "activity_heatmap",
            "type": "heatmap",
            "position": {"row": 4, "col": 1, "rowSpan": 1, "colSpan": 3},
            "config": {
              "title": "Processing Activity",
              "xAxis": "hour",
              "yAxis": "dayOfWeek",
              "metric": "transactionCount",
              "colorScale": "blue-red",
              "showTooltip": true
            }
          },
          {
            "widgetId": "alerts_feed",
            "type": "alert-list",
            "position": {"row": 4, "col": 4, "rowSpan": 1, "colSpan": 3},
            "config": {
              "title": "Real-time Alerts",
              "maxItems": 5,
              "autoScroll": true,
              "priority": ["critical", "high", "medium"],
              "actions": ["dismiss", "investigate"]
            }
          }
        ]
      },
      "drilldownModal": {
        "title": "Detailed Analysis",
        "size": "large",
        "content": {
          "type": "tabbed-analysis",
          "tabs": [
            {
              "tabId": "detail",
              "tabLabel": "Detailed Data",
              "content": "dynamic_grid_based_on_widget"
            },
            {
              "tabId": "trends",
              "tabLabel": "Trend Analysis",
              "content": "trend_charts"
            },
            {
              "tabId": "export",
              "tabLabel": "Export Options",
              "content": "export_configuration"
            }
          ]
        }
      }
    }
  }
}