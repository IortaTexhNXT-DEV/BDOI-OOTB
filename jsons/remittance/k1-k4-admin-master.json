{
  "remittance_admin_masters": {
    "k1_automated_remittance_master": {
      "featureId": "K1-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Automated Remittance Master",
      "screenCode": "FIN_MAS_REM_001",
      "menuPath": "Finance > Master > Remittance Master > Automated Remittance Setup",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "tabs": [
        {
          "tabId": "general",
          "tabLabel": "General",
          "sections": [
            {
              "sectionTitle": "Automation Rule Configuration",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "Rule Code",
                  "fieldId": "ruleCode",
                  "type": "text",
                  "required": true,
                  "unique": true,
                  "format": "ARM-{0000}",
                  "width": "33%"
                },
                {
                  "fieldName": "Rule Name",
                  "fieldId": "ruleName",
                  "type": "text",
                  "required": true,
                  "maxLength": 100,
                  "width": "33%"
                },
                {
                  "fieldName": "Active",
                  "fieldId": "isActive",
                  "type": "checkbox",
                  "defaultValue": false,
                  "width": "33%"
                }
              ]
            },
            {
              "sectionTitle": "Processing Rules",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Frequency",
                  "fieldId": "frequency",
                  "type": "dropdown",
                  "options": ["Daily", "Weekly", "Monthly", "Quarterly"],
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Processing Day",
                  "fieldId": "processingDay",
                  "type": "number",
                  "min": 1,
                  "max": 31,
                  "conditional": "frequency=Monthly",
                  "width": "50%"
                },
                {
                  "fieldName": "Cut-off Days",
                  "fieldId": "cutoffDays",
                  "type": "number",
                  "defaultValue": 3,
                  "helpText": "Days before period end",
                  "width": "50%"
                },
                {
                  "fieldName": "Min Transaction Count",
                  "fieldId": "minTransCount",
                  "type": "number",
                  "defaultValue": 1,
                  "width": "50%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "glMapping",
          "tabLabel": "GL Mapping",
          "sections": [
            {
              "sectionTitle": "Account Configuration",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "Main Account",
                  "fieldId": "mainAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "lookupScreen": "mainAccountMaster",
                  "width": "33%"
                },
                {
                  "fieldName": "Sub Account",
                  "fieldId": "subAccount",
                  "type": "text",
                  "lookupButton": true,
                  "lookupScreen": "subAccountMaster",
                  "width": "33%"
                },
                {
                  "fieldName": "Branch/Department",
                  "fieldId": "branchDept",
                  "type": "dropdown",
                  "source": "branchDepartmentMaster",
                  "required": true,
                  "width": "33%"
                }
              ]
            }
          ]
        }
      ],
      "actionButtons": {
        "position": "bottom-right",
        "buttons": [
          {
            "label": "Save",
            "action": "save",
            "type": "primary"
          },
          {
            "label": "Delete",
            "action": "delete",
            "type": "danger",
            "conditional": "mode=edit"
          },
          {
            "label": "Close",
            "action": "close",
            "type": "secondary"
          }
        ]
      }
    },
    "k3_statement_template_master": {
      "featureId": "K3-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Statement Template Master",
      "screenCode": "FIN_MAS_REM_003",
      "menuPath": "Finance > Master > Remittance Master > Statement Template",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "tabs": [
        {
          "tabId": "template",
          "tabLabel": "Template Configuration",
          "sections": [
            {
              "sectionTitle": "Template Details",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Template Code",
                  "fieldId": "templateCode",
                  "type": "text",
                  "required": true,
                  "unique": true,
                  "format": "STM-{000}",
                  "width": "50%"
                },
                {
                  "fieldName": "Template Name",
                  "fieldId": "templateName",
                  "type": "text",
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Statement Type",
                  "fieldId": "statementType",
                  "type": "dropdown",
                  "options": ["Monthly", "Quarterly", "Annual", "Custom"],
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Active",
                  "fieldId": "isActive",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "50%"
                }
              ]
            },
            {
              "sectionTitle": "Column Configuration",
              "layout": "single-column",
              "fields": [
                {
                  "fieldName": "Available Columns",
                  "fieldId": "columns",
                  "type": "dual-listbox",
                  "leftTitle": "Available",
                  "rightTitle": "Selected",
                  "options": [
                    "Policy Number",
                    "Insured Name",
                    "Product",
                    "Effective Date",
                    "Premium",
                    "Commission Rate",
                    "Commission Amount",
                    "Service Tax",
                    "Net Amount"
                  ]
                }
              ]
            }
          ]
        },
        {
          "tabId": "format",
          "tabLabel": "Format Settings",
          "sections": [
            {
              "sectionTitle": "Header Configuration",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Show Company Logo",
                  "fieldId": "showLogo",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Show Address",
                  "fieldId": "showAddress",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Header Text",
                  "fieldId": "headerText",
                  "type": "textarea",
                  "rows": 3,
                  "width": "100%"
                }
              ]
            },
            {
              "sectionTitle": "Footer Configuration",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Show Totals",
                  "fieldId": "showTotals",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Signature Lines",
                  "fieldId": "signatureLines",
                  "type": "number",
                  "min": 0,
                  "max": 3,
                  "defaultValue": 2,
                  "width": "50%"
                },
                {
                  "fieldName": "Terms & Conditions",
                  "fieldId": "termsConditions",
                  "type": "textarea",
                  "rows": 4,
                  "width": "100%"
                }
              ]
            }
          ]
        }
      ]
    },
    "k4_settlement_parameter_master": {
      "featureId": "K4-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Settlement Parameter Master",
      "screenCode": "FIN_MAS_REM_004",
      "menuPath": "Finance > Master > Remittance Master > Settlement Parameters",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "tabs": [
        {
          "tabId": "parameters",
          "tabLabel": "Parameters",
          "sections": [
            {
              "sectionTitle": "Settlement Rules",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Parameter Code",
                  "fieldId": "paramCode",
                  "type": "text",
                  "required": true,
                  "unique": true,
                  "format": "STP-{000}",
                  "width": "50%"
                },
                {
                  "fieldName": "Parameter Name",
                  "fieldId": "paramName",
                  "type": "text",
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Settlement Type",
                  "fieldId": "settlementType",
                  "type": "dropdown",
                  "options": ["Regular", "Provisional", "Final", "Adjustment"],
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Auto Calculate",
                  "fieldId": "autoCalculate",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "50%"
                }
              ]
            },
            {
              "sectionTitle": "Approval Limits",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "Level 1 Limit",
                  "fieldId": "level1Limit",
                  "type": "decimal",
                  "defaultValue": 50000.00,
                  "width": "33%"
                },
                {
                  "fieldName": "Level 2 Limit",
                  "fieldId": "level2Limit",
                  "type": "decimal",
                  "defaultValue": 100000.00,
                  "width": "33%"
                },
                {
                  "fieldName": "Level 3 Limit",
                  "fieldId": "level3Limit",
                  "type": "decimal",
                  "defaultValue": 500000.00,
                  "width": "33%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "glAccounts",
          "tabLabel": "GL Accounts",
          "sections": [
            {
              "sectionTitle": "Settlement GL Configuration",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Settlement Payable Account",
                  "fieldId": "payableAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Settlement Clearing Account",
                  "fieldId": "clearingAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Commission Account",
                  "fieldId": "commissionAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Tax Account",
                  "fieldId": "taxAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "remittance_setups": {
    "remittance_gl_setup": {
      "featureId": "REM-SETUP-001",
      "screenCategory": "SETUP",
      "screenTitle": "Remittance GL Setup",
      "screenCode": "FIN_SET_REM_001",
      "menuPath": "Finance > Setups > Remittance Setup > GL Account Setup",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "sections": [
        {
          "sectionTitle": "Default GL Accounts",
          "layout": "two-column",
          "fields": [
            {
              "fieldName": "Default Remittance Account",
              "fieldId": "defaultRemittanceAcc",
              "type": "text",
              "required": true,
              "lookupButton": true,
              "lookupScreen": "glAccountMaster",
              "width": "50%"
            },
            {
              "fieldName": "Default Commission Account",
              "fieldId": "defaultCommissionAcc",
              "type": "text",
              "required": true,
              "lookupButton": true,
              "lookupScreen": "glAccountMaster",
              "width": "50%"
            },
            {
              "fieldName": "Suspense Account",
              "fieldId": "suspenseAccount",
              "type": "text",
              "required": true,
              "lookupButton": true,
              "width": "50%"
            },
            {
              "fieldName": "Write-off Account",
              "fieldId": "writeOffAccount",
              "type": "text",
              "required": true,
              "lookupButton": true,
              "width": "50%"
            }
          ]
        }
      ]
    },
    "remittance_approval_setup": {
      "featureId": "REM-SETUP-002",
      "screenCategory": "SETUP",
      "screenTitle": "Remittance Approval Matrix",
      "screenCode": "FIN_SET_REM_002",
      "menuPath": "Finance > Setups > Remittance Setup > Approval Matrix",
      "accessRoles": ["ADMIN"],
      "gridSection": {
        "title": "Approval Matrix Configuration",
        "editable": true,
        "columns": [
          {
            "field": "fromAmount",
            "header": "From Amount",
            "type": "decimal",
            "editable": true,
            "width": "20%"
          },
          {
            "field": "toAmount",
            "header": "To Amount",
            "type": "decimal",
            "editable": true,
            "width": "20%"
          },
          {
            "field": "approver1",
            "header": "Level 1 Approver",
            "type": "dropdown",
            "source": "userRoles",
            "editable": true,
            "width": "20%"
          },
          {
            "field": "approver2",
            "header": "Level 2 Approver",
            "type": "dropdown",
            "source": "userRoles",
            "editable": true,
            "width": "20%"
          },
          {
            "field": "approver3",
            "header": "Level 3 Approver",
            "type": "dropdown",
            "source": "userRoles",
            "editable": true,
            "width": "20%"
          }
        ],
        "toolbar": [
          {
            "label": "Add Row",
            "action": "addRow",
            "icon": "plus"
          },
          {
            "label": "Delete Row",
            "action": "deleteRow",
            "icon": "delete"
          }
        ]
      }
    }
  }
}