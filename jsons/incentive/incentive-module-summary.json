{
  "module_name": "Incentive Management System",
  "module_code": "S",
  "description": "Comprehensive incentive management for Philippines insurance brokers, covering program setup, calculation, and reporting",
  "target_users": [
    "System Administrators",
    "Incentive Managers",
    "Branch Managers",
    "Individual Agents/Brokers",
    "Finance Team"
  ],
  "mvp_features": {
    "S1_incentive_programs": {
      "master_screens": [
        {
          "name": "Incentive Program Master",
          "route": "/master/incentive/programs",
          "purpose": "Setup and configure incentive programs"
        }
      ],
      "user_screens": [
        {
          "name": "My Programs",
          "route": "/incentive/my-programs",
          "purpose": "View assigned programs and track progress"
        }
      ]
    },
    "S3_reward_calculations": {
      "screens": [
        {
          "name": "Calculate Incentives",
          "route": "/incentive/calculations",
          "purpose": "Run monthly incentive calculations"
        },
        {
          "name": "Approve Incentives",
          "route": "/incentive/approvals",
          "purpose": "Review and approve calculated incentives"
        }
      ]
    },
    "S4_incentive_reports": {
      "screens": [
        {
          "name": "Reports Dashboard",
          "route": "/incentive/reports",
          "purpose": "Generate various incentive reports"
        },
        {
          "name": "My Statement",
          "route": "/incentive/statement",
          "purpose": "View personal incentive statement"
        }
      ]
    }
  },
  "implementation_plan": {
    "phase_1": {
      "duration": "Sprint 1",
      "deliverables": [
        "Incentive Program Master setup",
        "Basic CRUD operations",
        "Program assignment to agents"
      ]
    },
    "phase_2": {
      "duration": "Sprint 2",
      "deliverables": [
        "Calculation engine",
        "Approval workflow",
        "Agent dashboard"
      ]
    },
    "phase_3": {
      "duration": "Sprint 3",
      "deliverables": [
        "Report templates",
        "Statement generation",
        "Export functionality"
      ]
    }
  },
  "integration_points": [
    {
      "module": "Policy Management",
      "purpose": "Fetch premium and policy data for calculations"
    },
    {
      "module": "Agent Management",
      "purpose": "Get agent hierarchy and assignments"
    },
    {
      "module": "Finance",
      "purpose": "Payment processing and GL posting"
    }
  ],
  "key_workflows": [
    {
      "name": "Monthly Incentive Cycle",
      "steps": [
        "Period closes",
        "Data aggregation",
        "Run calculations",
        "Review exceptions",
        "Manager approval",
        "Generate statements",
        "Process payments"
      ]
    },
    {
      "name": "Program Setup",
      "steps": [
        "Define program parameters",
        "Set targets and slabs",
        "Assign to agents/teams",
        "Activate program",
        "Monitor performance"
      ]
    }
  ],
  "mock_data_requirements": [
    "5-10 incentive programs with different types",
    "20-30 agents with varying performance levels",
    "6 months of historical performance data",
    "Sample calculation results",
    "Pre-defined report templates"
  ],
  "ui_components_reuse": [
    "DataTable from existing codebase",
    "Card components for dashboards",
    "TabView for multi-section forms",
    "Steps component for calculation wizard",
    "Chart components for visualizations",
    "Toast for notifications",
    "Dialog for confirmations"
  ],
  "permissions_matrix": {
    "admin": ["all"],
    "incentive_manager": ["create_program", "run_calculation", "approve_payouts", "view_all_reports"],
    "branch_manager": ["view_team_performance", "approve_team_payouts", "view_team_reports"],
    "agent": ["view_own_programs", "view_own_statement", "view_own_performance"],
    "finance": ["view_payout_reports", "process_payments", "view_budget_reports"]
  }
}