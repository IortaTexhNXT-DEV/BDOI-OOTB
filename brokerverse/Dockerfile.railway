# BrokerVerse web on Railway: the same image as Dockerfile, listening on Railway's $PORT (8080 by default).
# Nothing about the environment is baked into the build. Set on the Railway service (deploy/RAILWAY.md):
#   API_UPSTREAM=http://api.railway.internal:8000   same-origin /api through the private network (recommended)
#   or API_BASE_URL=https://<api address>/api        the browser calls the API service directly
#   ENVIRONMENT_NAME=UAT                             label next to the logo (empty or PRODUCTION: none)
# They are applied when the container starts, so changing one needs a restart, not a rebuild.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
ARG REACT_APP_BASE_URL=
ENV REACT_APP_BASE_URL=$REACT_APP_BASE_URL CI=false GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false
RUN npm run build \
 && ! grep -q "%PUBLIC_URL%" build/index.html \
 && grep -q "/static/js/" build/index.html \
 && grep -q "env-config.js" build/index.html

FROM nginx:1.27-alpine
ENV PORT=8080 \
    API_UPSTREAM= \
    API_BASE_URL= \
    ENVIRONMENT_NAME= \
    ENVIRONMENT_COLOR= \
    ANALYTICS_ENABLED=false
COPY scripts/env-config.sh scripts/nginx-snippets.sh /opt/brokerverse/
COPY nginx/40-brokerverse-runtime.sh /docker-entrypoint.d/40-brokerverse-runtime.sh
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
RUN chmod 755 /opt/brokerverse/*.sh /docker-entrypoint.d/40-brokerverse-runtime.sh \
 && rm -f /etc/nginx/conf.d/default.conf && mkdir -p /etc/nginx/brokerverse
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 8080
