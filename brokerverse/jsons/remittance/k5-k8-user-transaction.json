{
  "remittance_user_transactions_k5_k8": {
    "k5_remittance_reconciliation": {
      "featureId": "K5-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Remittance Reconciliation",
      "screenCode": "FIN_TRN_REM_005",
      "menuPath": "Finance > Remittance > Reconciliation > Process Reconciliation",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "headerSection": {
        "layout": "info-bar",
        "fields": [
          {
            "label": "Reconciliation Period",
            "value": "currentPeriod",
            "type": "month-year",
            "editable": true
          },
          {
            "label": "Unmatched Items",
            "value": "unmatchedCount",
            "type": "number",
            "highlight": true,
            "color": "orange"
          },
          {
            "label": "Matched Items",
            "value": "matchedCount",
            "type": "number",
            "color": "green"
          },
          {
            "label": "Total Difference",
            "value": "totalDifference",
            "type": "currency",
            "highlight": true,
            "color": "red"
          }
        ]
      },
      "mainSection": {
        "layout": "three-panel",
        "leftPanel": {
          "title": "Bank Transactions",
          "width": "35%",
          "toolbar": [
            {
              "label": "Import",
              "action": "importBank",
              "icon": "upload"
            },
            {
              "label": "Refresh",
              "action": "refreshBank",
              "icon": "refresh"
            }
          ],
          "gridColumns": [
            {
              "field": "select",
              "type": "checkbox",
              "width": "8%"
            },
            {
              "field": "transDate",
              "header": "Date",
              "width": "25%",
              "format": "date"
            },
            {
              "field": "reference",
              "header": "Reference",
              "width": "30%"
            },
            {
              "field": "amount",
              "header": "Amount",
              "width": "25%",
              "align": "right",
              "format": "currency"
            },
            {
              "field": "status",
              "header": "Status",
              "width": "12%",
              "type": "icon",
              "icons": {
                "matched": "check-green",
                "unmatched": "warning-orange",
                "partial": "info-blue"
              }
            }
          ],
          "summary": {
            "totalItems": "count",
            "totalAmount": "sum",
            "matchedAmount": "conditional-sum"
          }
        },
        "centerPanel": {
          "title": "Matching Area",
          "width": "30%",
          "sections": [
            {
              "sectionTitle": "Auto-Match",
              "fields": [
                {
                  "fieldName": "Match Criteria",
                  "fieldId": "matchCriteria",
                  "type": "dropdown",
                  "options": ["Exact", "Fuzzy", "Amount Only", "Reference Only"],
                  "defaultValue": "Exact"
                },
                {
                  "fieldName": "Tolerance (%)",
                  "fieldId": "tolerance",
                  "type": "decimal",
                  "min": 0,
                  "max": 10,
                  "defaultValue": 0,
                  "conditional": "matchCriteria=Fuzzy"
                },
                {
                  "buttons": [
                    {
                      "label": "Auto Match",
                      "action": "autoMatch",
                      "type": "primary",
                      "fullWidth": true,
                      "icon": "magic"
                    }
                  ]
                }
              ]
            },
            {
              "sectionTitle": "Manual Match",
              "fields": [
                {
                  "label": "Selected Bank: ",
                  "value": "selectedBankCount",
                  "type": "info"
                },
                {
                  "label": "Selected System: ",
                  "value": "selectedSystemCount",
                  "type": "info"
                },
                {
                  "label": "Difference: ",
                  "value": "selectionDifference",
                  "type": "currency",
                  "highlight": true
                },
                {
                  "buttons": [
                    {
                      "label": "Match Selected",
                      "action": "matchSelected",
                      "type": "success",
                      "fullWidth": true,
                      "conditional": "canMatch",
                      "icon": "link"
                    },
                    {
                      "label": "Force Match",
                      "action": "forceMatch",
                      "type": "warning",
                      "fullWidth": true,
                      "conditional": "hasDifference",
                      "requireConfirmation": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        "rightPanel": {
          "title": "System Transactions",
          "width": "35%",
          "toolbar": [
            {
              "label": "Load",
              "action": "loadSystem",
              "icon": "database"
            },
            {
              "label": "Filter",
              "action": "filterSystem",
              "icon": "filter"
            }
          ],
          "gridColumns": [
            {
              "field": "select",
              "type": "checkbox",
              "width": "8%"
            },
            {
              "field": "remittanceDate",
              "header": "Date",
              "width": "25%",
              "format": "date"
            },
            {
              "field": "remittanceNo",
              "header": "Remit No",
              "width": "30%"
            },
            {
              "field": "netAmount",
              "header": "Amount",
              "width": "25%",
              "align": "right",
              "format": "currency"
            },
            {
              "field": "status",
              "header": "Status",
              "width": "12%",
              "type": "icon"
            }
          ],
          "summary": {
            "totalItems": "count",
            "totalAmount": "sum",
            "matchedAmount": "conditional-sum"
          }
        }
      },
      "matchedSection": {
        "title": "Matched Items",
        "collapsible": true,
        "collapsed": false,
        "gridColumns": [
          {
            "field": "matchId",
            "header": "Match ID",
            "width": "10%"
          },
          {
            "field": "bankRef",
            "header": "Bank Reference",
            "width": "20%"
          },
          {
            "field": "systemRef",
            "header": "System Reference",
            "width": "20%"
          },
          {
            "field": "bankAmount",
            "header": "Bank Amount",
            "width": "15%",
            "align": "right",
            "format": "currency"
          },
          {
            "field": "systemAmount",
            "header": "System Amount",
            "width": "15%",
            "align": "right",
            "format": "currency"
          },
          {
            "field": "difference",
            "header": "Difference",
            "width": "10%",
            "align": "right",
            "format": "currency",
            "highlight": "non-zero"
          },
          {
            "field": "actions",
            "header": "Actions",
            "width": "10%",
            "type": "action-buttons",
            "actions": [
              {
                "icon": "unlink",
                "tooltip": "Unmatch",
                "action": "unmatch"
              },
              {
                "icon": "view",
                "tooltip": "View Details",
                "action": "viewDetails"
              }
            ]
          }
        ]
      },
      "actionButtons": {
        "position": "bottom-right",
        "buttons": [
          {
            "label": "Save Progress",
            "action": "save",
            "type": "secondary"
          },
          {
            "label": "Complete Reconciliation",
            "action": "complete",
            "type": "primary",
            "requireValidation": true,
            "confirmation": true
          },
          {
            "label": "Export Report",
            "action": "export",
            "type": "secondary",
            "icon": "download"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "type": "link"
          }
        ]
      }
    },
    "k6_bulk_remittance_processing": {
      "featureId": "K6-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Bulk Remittance Processing",
      "screenCode": "FIN_TRN_REM_006",
      "menuPath": "Finance > Remittance > Bulk Processing > Upload & Process",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "wizardSteps": [
        {
          "stepId": "upload",
          "stepLabel": "Upload File",
          "stepNumber": 1,
          "sections": [
            {
              "sectionTitle": "File Selection",
              "layout": "centered",
              "fields": [
                {
                  "fieldName": "File Format",
                  "fieldId": "fileFormat",
                  "type": "dropdown",
                  "source": "bulkFormatMaster",
                  "required": true,
                  "onChange": "loadFormatSettings"
                },
                {
                  "fieldName": "Upload File",
                  "fieldId": "uploadFile",
                  "type": "file-upload-area",
                  "accept": ".csv,.xlsx,.xls,.xml,.txt",
                  "maxSize": "50MB",
                  "dragDrop": true,
                  "icon": "cloud-upload",
                  "mainText": "Drag and drop file here",
                  "subText": "or click to browse",
                  "required": true
                }
              ]
            },
            {
              "sectionTitle": "File Information",
              "conditional": "fileUploaded",
              "layout": "info-display",
              "fields": [
                {
                  "label": "File Name",
                  "value": "fileName",
                  "type": "text"
                },
                {
                  "label": "File Size",
                  "value": "fileSize",
                  "type": "size"
                },
                {
                  "label": "Upload Time",
                  "value": "uploadTime",
                  "type": "datetime"
                },
                {
                  "label": "Format",
                  "value": "detectedFormat",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "stepId": "validate",
          "stepLabel": "Validate",
          "stepNumber": 2,
          "sections": [
            {
              "sectionTitle": "Validation Progress",
              "type": "progress-display",
              "fields": [
                {
                  "fieldName": "Validation Status",
                  "fieldId": "validationStatus",
                  "type": "progress-bar",
                  "stages": [
                    {"stage": "File Structure", "status": "dynamic"},
                    {"stage": "Data Types", "status": "dynamic"},
                    {"stage": "Required Fields", "status": "dynamic"},
                    {"stage": "Business Rules", "status": "dynamic"},
                    {"stage": "Duplicates Check", "status": "dynamic"}
                  ]
                }
              ]
            },
            {
              "sectionTitle": "Validation Summary",
              "layout": "cards",
              "cards": [
                {
                  "title": "Total Records",
                  "value": "totalRecords",
                  "icon": "file",
                  "color": "blue"
                },
                {
                  "title": "Valid Records",
                  "value": "validRecords",
                  "icon": "check",
                  "color": "green"
                },
                {
                  "title": "Warnings",
                  "value": "warningCount",
                  "icon": "warning",
                  "color": "orange"
                },
                {
                  "title": "Errors",
                  "value": "errorCount",
                  "icon": "error",
                  "color": "red"
                }
              ]
            },
            {
              "sectionTitle": "Validation Details",
              "type": "tabbed-grid",
              "tabs": [
                {
                  "tabLabel": "Errors",
                  "gridColumns": [
                    {"field": "rowNo", "header": "Row", "width": "10%"},
                    {"field": "fieldName", "header": "Field", "width": "20%"},
                    {"field": "value", "header": "Value", "width": "25%"},
                    {"field": "error", "header": "Error", "width": "35%"},
                    {"field": "action", "header": "Action", "width": "10%", "type": "dropdown", "options": ["Skip", "Fix", "Accept"]}
                  ]
                },
                {
                  "tabLabel": "Warnings",
                  "gridColumns": [
                    {"field": "rowNo", "header": "Row", "width": "10%"},
                    {"field": "fieldName", "header": "Field", "width": "20%"},
                    {"field": "value", "header": "Value", "width": "25%"},
                    {"field": "warning", "header": "Warning", "width": "35%"},
                    {"field": "action", "header": "Action", "width": "10%", "type": "dropdown", "options": ["Ignore", "Review"]}
                  ]
                }
              ]
            }
          ]
        },
        {
          "stepId": "preview",
          "stepLabel": "Preview",
          "stepNumber": 3,
          "sections": [
            {
              "sectionTitle": "Data Preview",
              "type": "preview-grid",
              "toolbar": [
                {
                  "label": "Show All",
                  "action": "showAll",
                  "type": "radio"
                },
                {
                  "label": "Show Valid",
                  "action": "showValid",
                  "type": "radio"
                },
                {
                  "label": "Show Errors",
                  "action": "showErrors",
                  "type": "radio"
                }
              ],
              "gridColumns": [
                {
                  "field": "status",
                  "header": "",
                  "width": "5%",
                  "type": "status-icon"
                },
                {
                  "field": "rowNo",
                  "header": "Row",
                  "width": "8%"
                },
                {
                  "field": "insurerCode",
                  "header": "Insurer",
                  "width": "10%"
                },
                {
                  "field": "policyNo",
                  "header": "Policy No",
                  "width": "12%"
                },
                {
                  "field": "insuredName",
                  "header": "Insured",
                  "width": "15%"
                },
                {
                  "field": "effectiveDate",
                  "header": "Eff Date",
                  "width": "10%",
                  "format": "date"
                },
                {
                  "field": "premium",
                  "header": "Premium",
                  "width": "12%",
                  "align": "right",
                  "format": "currency"
                },
                {
                  "field": "commission",
                  "header": "Commission",
                  "width": "10%",
                  "align": "right",
                  "format": "currency"
                },
                {
                  "field": "netAmount",
                  "header": "Net Amount",
                  "width": "12%",
                  "align": "right",
                  "format": "currency"
                },
                {
                  "field": "include",
                  "header": "Include",
                  "width": "6%",
                  "type": "checkbox",
                  "editable": true
                }
              ],
              "features": {
                "pagination": true,
                "pageSize": 50,
                "editable": true
              }
            },
            {
              "sectionTitle": "Processing Summary",
              "layout": "summary-table",
              "fields": [
                {
                  "label": "Records to Process",
                  "value": "recordsToProcess",
                  "type": "number"
                },
                {
                  "label": "Total Premium",
                  "value": "totalPremium",
                  "type": "currency"
                },
                {
                  "label": "Total Commission",
                  "value": "totalCommission",
                  "type": "currency"
                },
                {
                  "label": "Net Remittance",
                  "value": "netRemittance",
                  "type": "currency",
                  "highlight": true
                }
              ]
            }
          ]
        },
        {
          "stepId": "process",
          "stepLabel": "Process",
          "stepNumber": 4,
          "sections": [
            {
              "sectionTitle": "Processing Options",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Processing Date",
                  "fieldId": "processingDate",
                  "type": "date",
                  "defaultValue": "currentDate",
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Batch Name",
                  "fieldId": "batchName",
                  "type": "text",
                  "required": true,
                  "defaultValue": "BULK-{DATE}-{SEQ}",
                  "width": "50%"
                },
                {
                  "fieldName": "Create Separate Remittances",
                  "fieldId": "separateRemittances",
                  "type": "checkbox",
                  "defaultValue": true,
                  "helpText": "Create one remittance per insurer",
                  "width": "50%"
                },
                {
                  "fieldName": "Auto-Approve",
                  "fieldId": "autoApprove",
                  "type": "checkbox",
                  "defaultValue": false,
                  "conditional": "hasApprovalRights",
                  "width": "50%"
                }
              ]
            },
            {
              "sectionTitle": "Processing Status",
              "type": "real-time-progress",
              "fields": [
                {
                  "fieldName": "Processing Progress",
                  "fieldId": "progress",
                  "type": "progress-indicator",
                  "showPercentage": true,
                  "showCount": true,
                  "showEstimatedTime": true
                },
                {
                  "fieldName": "Processing Log",
                  "fieldId": "processingLog",
                  "type": "scrollable-log",
                  "height": "200px",
                  "autoScroll": true
                }
              ]
            }
          ]
        }
      ],
      "wizardActions": {
        "position": "bottom",
        "buttons": [
          {
            "label": "Previous",
            "action": "previousStep",
            "type": "secondary",
            "conditional": "currentStep>1"
          },
          {
            "label": "Next",
            "action": "nextStep",
            "type": "primary",
            "conditional": "currentStep<4&&canProceed"
          },
          {
            "label": "Process",
            "action": "processBatch",
            "type": "success",
            "conditional": "currentStep=4",
            "confirmation": true
          },
          {
            "label": "Save Draft",
            "action": "saveDraft",
            "type": "secondary"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "type": "link"
          }
        ]
      }
    },
    "k7_remittance_scheduling": {
      "featureId": "K7-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Remittance Schedule Management",
      "screenCode": "FIN_TRN_REM_007",
      "menuPath": "Finance > Remittance > Scheduling > Manage Schedule",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "viewToggle": {
        "options": ["Calendar", "List", "Timeline"],
        "default": "Calendar"
      },
      "calendarView": {
        "viewType": "monthly-calendar",
        "conditional": "view=Calendar",
        "features": {
          "dragDrop": true,
          "multiSelect": true,
          "contextMenu": true
        },
        "eventDisplay": {
          "title": "{insurerName}",
          "subtitle": "{amount}",
          "color": "byStatus",
          "statusColors": {
            "scheduled": "blue",
            "processing": "orange",
            "completed": "green",
            "failed": "red",
            "skipped": "gray"
          }
        },
        "toolbar": [
          {
            "label": "Today",
            "action": "goToday"
          },
          {
            "label": "Previous",
            "action": "goPrevious",
            "icon": "arrow-left"
          },
          {
            "label": "Next",
            "action": "goNext",
            "icon": "arrow-right"
          },
          {
            "label": "Month",
            "action": "viewMonth",
            "type": "radio"
          },
          {
            "label": "Week",
            "action": "viewWeek",
            "type": "radio"
          },
          {
            "label": "Day",
            "action": "viewDay",
            "type": "radio"
          }
        ],
        "sidePanel": {
          "title": "Schedule Details",
          "showOn": "eventClick",
          "fields": [
            {
              "fieldName": "Schedule Code",
              "fieldId": "scheduleCode",
              "type": "text",
              "readonly": true
            },
            {
              "fieldName": "Insurer",
              "fieldId": "insurerName",
              "type": "text",
              "readonly": true
            },
            {
              "fieldName": "Scheduled Date",
              "fieldId": "scheduledDate",
              "type": "date",
              "editable": true
            },
            {
              "fieldName": "Scheduled Time",
              "fieldId": "scheduledTime",
              "type": "time",
              "editable": true
            },
            {
              "fieldName": "Expected Amount",
              "fieldId": "expectedAmount",
              "type": "currency",
              "readonly": true
            },
            {
              "fieldName": "Status",
              "fieldId": "status",
              "type": "dropdown",
              "options": ["Scheduled", "On Hold", "Skip Once"],
              "editable": true
            },
            {
              "fieldName": "Notes",
              "fieldId": "notes",
              "type": "textarea",
              "rows": 3,
              "editable": true
            }
          ],
          "actions": [
            {
              "label": "Save Changes",
              "action": "saveSchedule",
              "type": "primary"
            },
            {
              "label": "Process Now",
              "action": "processNow",
              "type": "success"
            },
            {
              "label": "Delete",
              "action": "deleteSchedule",
              "type": "danger"
            }
          ]
        }
      },
      "listView": {
        "conditional": "view=List",
        "filterSection": {
          "layout": "horizontal",
          "fields": [
            {
              "fieldName": "Date Range",
              "fieldId": "dateRange",
              "type": "date-range",
              "defaultValue": "currentMonth",
              "width": "30%"
            },
            {
              "fieldName": "Insurer",
              "fieldId": "insurer",
              "type": "multiselect",
              "source": "insurerMaster",
              "width": "25%"
            },
            {
              "fieldName": "Status",
              "fieldId": "status",
              "type": "multiselect",
              "options": ["Scheduled", "Processing", "Completed", "Failed", "On Hold"],
              "width": "25%"
            },
            {
              "buttons": [
                {
                  "label": "Search",
                  "action": "search",
                  "type": "primary"
                },
                {
                  "label": "Reset",
                  "action": "reset",
                  "type": "link"
                }
              ],
              "width": "20%"
            }
          ]
        },
        "gridSection": {
          "columns": [
            {
              "field": "select",
              "type": "checkbox",
              "width": "5%"
            },
            {
              "field": "scheduleCode",
              "header": "Schedule Code",
              "width": "12%",
              "sortable": true
            },
            {
              "field": "insurerCode",
              "header": "Insurer Code",
              "width": "10%",
              "sortable": true
            },
            {
              "field": "insurerName",
              "header": "Insurer Name",
              "width": "15%",
              "sortable": true
            },
            {
              "field": "scheduledDate",
              "header": "Scheduled Date",
              "width": "12%",
              "format": "date",
              "sortable": true
            },
            {
              "field": "scheduledTime",
              "header": "Time",
              "width": "8%",
              "format": "time"
            },
            {
              "field": "frequency",
              "header": "Frequency",
              "width": "10%"
            },
            {
              "field": "expectedAmount",
              "header": "Expected Amount",
              "width": "12%",
              "align": "right",
              "format": "currency"
            },
            {
              "field": "status",
              "header": "Status",
              "width": "10%",
              "type": "status-badge"
            },
            {
              "field": "actions",
              "header": "Actions",
              "width": "6%",
              "type": "action-buttons",
              "actions": [
                {
                  "icon": "edit",
                  "tooltip": "Edit",
                  "action": "edit"
                },
                {
                  "icon": "play",
                  "tooltip": "Process Now",
                  "action": "processNow",
                  "conditional": "status=Scheduled"
                },
                {
                  "icon": "pause",
                  "tooltip": "Hold",
                  "action": "hold",
                  "conditional": "status=Scheduled"
                }
              ]
            }
          ],
          "bulkActions": [
            {
              "label": "Process Selected",
              "action": "bulkProcess",
              "type": "primary"
            },
            {
              "label": "Hold Selected",
              "action": "bulkHold",
              "type": "warning"
            },
            {
              "label": "Delete Selected",
              "action": "bulkDelete",
              "type": "danger"
            }
          ]
        }
      },
      "timelineView": {
        "conditional": "view=Timeline",
        "type": "gantt-chart",
        "timeScale": "daily",
        "groupBy": "insurer",
        "features": {
          "zoom": true,
          "dragResize": true,
          "dependencies": true
        }
      },
      "actionButtons": {
        "position": "top-right",
        "buttons": [
          {
            "label": "Add Schedule",
            "action": "addSchedule",
            "type": "primary",
            "icon": "plus"
          },
          {
            "label": "Import Schedule",
            "action": "importSchedule",
            "type": "secondary",
            "icon": "upload"
          },
          {
            "label": "Export",
            "action": "export",
            "type": "secondary",
            "icon": "download"
          }
        ]
      }
    },
    "k8_electronic_remittance": {
      "featureId": "K8-USER",
      "screenCategory": "TRANSACTION",
      "screenTitle": "Electronic Remittance Transfer",
      "screenCode": "FIN_TRN_REM_008",
      "menuPath": "Finance > Remittance > Electronic Transfer > Create Transfer",
      "accessRoles": ["USER", "SUPERVISOR", "MANAGER"],
      "headerSection": {
        "layout": "five-column",
        "fields": [
          {
            "fieldName": "Transfer No",
            "fieldId": "transferNo",
            "type": "text",
            "readonly": true,
            "autoGenerated": true,
            "format": "EFT-{YYYY}-{00000}",
            "width": "20%"
          },
          {
            "fieldName": "Transfer Date",
            "fieldId": "transferDate",
            "type": "date",
            "required": true,
            "defaultValue": "currentDate",
            "width": "20%"
          },
          {
            "fieldName": "Transfer Type",
            "fieldId": "transferType",
            "type": "dropdown",
            "source": "electronicTransferMaster",
            "required": true,
            "onChange": "loadTransferSettings",
            "width": "20%"
          },
          {
            "fieldName": "Currency",
            "fieldId": "currency",
            "type": "dropdown",
            "source": "currencyMaster",
            "defaultValue": "USD",
            "width": "20%"
          },
          {
            "fieldName": "Status",
            "fieldId": "status",
            "type": "text",
            "readonly": true,
            "defaultValue": "Draft",
            "statusColor": true,
            "width": "20%"
          }
        ]
      },
      "bodySection": {
        "tabs": [
          {
            "tabId": "remittances",
            "tabLabel": "Remittances",
            "sections": [
              {
                "sectionTitle": "Select Remittances",
                "layout": "filter-and-grid",
                "filterFields": [
                  {
                    "fieldName": "Insurer",
                    "fieldId": "filterInsurer",
                    "type": "dropdown",
                    "source": "insurerMaster"
                  },
                  {
                    "fieldName": "Status",
                    "fieldId": "filterStatus",
                    "type": "dropdown",
                    "options": ["Approved", "Pending Payment"],
                    "defaultValue": "Approved"
                  },
                  {
                    "buttons": [
                      {
                        "label": "Load Remittances",
                        "action": "loadRemittances",
                        "type": "primary"
                      }
                    ]
                  }
                ],
                "gridColumns": [
                  {
                    "field": "select",
                    "type": "checkbox",
                    "width": "5%"
                  },
                  {
                    "field": "remittanceNo",
                    "header": "Remittance No",
                    "width": "15%"
                  },
                  {
                    "field": "insurerName",
                    "header": "Insurer",
                    "width": "20%"
                  },
                  {
                    "field": "settlementDate",
                    "header": "Settlement Date",
                    "width": "12%",
                    "format": "date"
                  },
                  {
                    "field": "policyCount",
                    "header": "Policies",
                    "width": "8%",
                    "align": "center"
                  },
                  {
                    "field": "grossAmount",
                    "header": "Gross Amount",
                    "width": "13%",
                    "align": "right",
                    "format": "currency"
                  },
                  {
                    "field": "commission",
                    "header": "Commission",
                    "width": "12%",
                    "align": "right",
                    "format": "currency"
                  },
                  {
                    "field": "netAmount",
                    "header": "Net Amount",
                    "width": "15%",
                    "align": "right",
                    "format": "currency",
                    "bold": true
                  }
                ],
                "features": {
                  "selectable": true,
                  "selectAll": true,
                  "showSelectedSummary": true
                }
              }
            ]
          },
          {
            "tabId": "beneficiary",
            "tabLabel": "Beneficiary Details",
            "sections": [
              {
                "sectionTitle": "Beneficiary Information",
                "layout": "two-column",
                "fields": [
                  {
                    "fieldName": "Beneficiary Code",
                    "fieldId": "beneficiaryCode",
                    "type": "dropdown",
                    "source": "insurerBankMaster",
                    "required": true,
                    "onChange": "loadBeneficiaryDetails",
                    "width": "50%"
                  },
                  {
                    "fieldName": "Beneficiary Name",
                    "fieldId": "beneficiaryName",
                    "type": "text",
                    "required": true,
                    "width": "50%"
                  },
                  {
                    "fieldName": "Account Number",
                    "fieldId": "accountNumber",
                    "type": "text",
                    "required": true,
                    "masked": true,
                    "width": "50%"
                  },
                  {
                    "fieldName": "Account Type",
                    "fieldId": "accountType",
                    "type": "dropdown",
                    "options": ["Current", "Savings"],
                    "width": "50%"
                  }
                ]
              },
              {
                "sectionTitle": "Bank Information",
                "layout": "two-column",
                "fields": [
                  {
                    "fieldName": "Bank Name",
                    "fieldId": "bankName",
                    "type": "text",
                    "required": true,
                    "width": "50%"
                  },
                  {
                    "fieldName": "Branch",
                    "fieldId": "branch",
                    "type": "text",
                    "width": "50%"
                  },
                  {
                    "fieldName": "IFSC/SWIFT Code",
                    "fieldId": "bankCode",
                    "type": "text",
                    "required": true,
                    "width": "50%"
                  },
                  {
                    "fieldName": "Bank Address",
                    "fieldId": "bankAddress",
                    "type": "textarea",
                    "rows": 2,
                    "width": "50%"
                  }
                ]
              }
            ]
          },
          {
            "tabId": "payment",
            "tabLabel": "Payment Details",
            "sections": [
              {
                "sectionTitle": "Transfer Method",
                "layout": "three-column",
                "fields": [
                  {
                    "fieldName": "Payment Method",
                    "fieldId": "paymentMethod",
                    "type": "dropdown",
                    "options": ["NEFT", "RTGS", "IMPS", "Wire Transfer", "ACH"],
                    "required": true,
                    "onChange": "validateLimits",
                    "width": "33%"
                  },
                  {
                    "fieldName": "Priority",
                    "fieldId": "priority",
                    "type": "dropdown",
                    "options": ["Normal", "Urgent", "Same Day"],
                    "defaultValue": "Normal",
                    "width": "33%"
                  },
                  {
                    "fieldName": "Charges Bearer",
                    "fieldId": "chargesBearer",
                    "type": "dropdown",
                    "options": ["OUR", "BEN", "SHA"],
                    "defaultValue": "SHA",
                    "width": "33%"
                  }
                ]
              },
              {
                "sectionTitle": "Amount Details",
                "layout": "two-column",
                "fields": [
                  {
                    "fieldName": "Transfer Amount",
                    "fieldId": "transferAmount",
                    "type": "decimal",
                    "readonly": true,
                    "calculated": true,
                    "format": "currency",
                    "width": "50%"
                  },
                  {
                    "fieldName": "Bank Charges",
                    "fieldId": "bankCharges",
                    "type": "decimal",
                    "calculated": true,
                    "format": "currency",
                    "width": "50%"
                  },
                  {
                    "fieldName": "Total Debit Amount",
                    "fieldId": "totalDebitAmount",
                    "type": "decimal",
                    "readonly": true,
                    "calculated": true,
                    "format": "currency",
                    "bold": true,
                    "width": "50%"
                  },
                  {
                    "fieldName": "Value Date",
                    "fieldId": "valueDate",
                    "type": "date",
                    "defaultValue": "currentDate",
                    "width": "50%"
                  }
                ]
              },
              {
                "sectionTitle": "Payment Reference",
                "fields": [
                  {
                    "fieldName": "Payment Reference",
                    "fieldId": "paymentReference",
                    "type": "text",
                    "maxLength": 35,
                    "helpText": "Reference visible to beneficiary"
                  },
                  {
                    "fieldName": "Internal Reference",
                    "fieldId": "internalReference",
                    "type": "text"
                  },
                  {
                    "fieldName": "Remarks",
                    "fieldId": "remarks",
                    "type": "textarea",
                    "rows": 2
                  }
                ]
              }
            ]
          },
          {
            "tabId": "authorization",
            "tabLabel": "Authorization",
            "sections": [
              {
                "sectionTitle": "Approval Status",
                "type": "approval-chain",
                "stages": [
                  {
                    "level": "Initiated By",
                    "user": "currentUser",
                    "timestamp": "currentDateTime",
                    "status": "completed"
                  },
                  {
                    "level": "Level 1 Approval",
                    "user": "pending",
                    "limit": "< $50,000",
                    "status": "pending"
                  },
                  {
                    "level": "Level 2 Approval",
                    "user": "pending",
                    "limit": "$50,000 - $100,000",
                    "status": "conditional"
                  },
                  {
                    "level": "Final Authorization",
                    "user": "pending",
                    "limit": "> $100,000",
                    "status": "conditional"
                  }
                ]
              },
              {
                "sectionTitle": "Additional Verification",
                "conditional": "transferAmount>100000",
                "fields": [
                  {
                    "fieldName": "Verification Code",
                    "fieldId": "verificationCode",
                    "type": "otp-input",
                    "length": 6,
                    "sendOtpButton": true
                  },
                  {
                    "fieldName": "Authorized By",
                    "fieldId": "authorizedBy",
                    "type": "text",
                    "readonly": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "summarySection": {
        "title": "Transfer Summary",
        "layout": "highlight-box",
        "fields": [
          {
            "label": "Total Remittances",
            "value": "remittanceCount",
            "type": "number"
          },
          {
            "label": "Transfer Amount",
            "value": "transferAmount",
            "type": "currency"
          },
          {
            "label": "Bank Charges",
            "value": "bankCharges",
            "type": "currency"
          },
          {
            "label": "Total Amount",
            "value": "totalAmount",
            "type": "currency",
            "highlight": true
          }
        ]
      },
      "actionButtons": {
        "position": "bottom-right",
        "buttons": [
          {
            "label": "Save Draft",
            "action": "saveDraft",
            "type": "secondary"
          },
          {
            "label": "Validate",
            "action": "validate",
            "type": "secondary",
            "icon": "check"
          },
          {
            "label": "Submit for Approval",
            "action": "submitApproval",
            "type": "primary",
            "conditional": "status=Draft",
            "requireValidation": true
          },
          {
            "label": "Approve",
            "action": "approve",
            "type": "success",
            "conditional": "status=Pending&&hasApprovalRights"
          },
          {
            "label": "Process Transfer",
            "action": "processTransfer",
            "type": "success",
            "conditional": "status=Approved",
            "confirmation": true,
            "confirmationMessage": "This will initiate the electronic transfer. Continue?"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "type": "link"
          }
        ]
      }
    }
  }
}