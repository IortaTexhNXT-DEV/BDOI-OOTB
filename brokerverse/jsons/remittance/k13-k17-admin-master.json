{
  "remittance_admin_masters_k13_k17": {
    "k13_direct_bill_master": {
      "featureId": "K13-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Direct Bill Processing Master",
      "screenCode": "FIN_MAS_REM_013",
      "menuPath": "Finance > Master > Remittance Master > Direct Bill Configuration",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "tabs": [
        {
          "tabId": "configuration",
          "tabLabel": "Configuration",
          "sections": [
            {
              "sectionTitle": "Direct Bill Settings",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "Config Code",
                  "fieldId": "configCode",
                  "type": "text",
                  "required": true,
                  "unique": true,
                  "format": "DBL-{000}",
                  "width": "33%"
                },
                {
                  "fieldName": "Config Name",
                  "fieldId": "configName",
                  "type": "text",
                  "required": true,
                  "width": "33%"
                },
                {
                  "fieldName": "Active",
                  "fieldId": "isActive",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "33%"
                }
              ]
            },
            {
              "sectionTitle": "Billing Parameters",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Bill Generation Method",
                  "fieldId": "billMethod",
                  "type": "dropdown",
                  "options": ["Policy-wise", "Insured-wise", "Period-wise", "On-Demand"],
                  "defaultValue": "Policy-wise",
                  "width": "50%"
                },
                {
                  "fieldName": "Bill Frequency",
                  "fieldId": "billFrequency",
                  "type": "dropdown",
                  "options": ["Monthly", "Quarterly", "Semi-Annual", "Annual"],
                  "defaultValue": "Monthly",
                  "width": "50%"
                },
                {
                  "fieldName": "Payment Due Days",
                  "fieldId": "paymentDueDays",
                  "type": "number",
                  "defaultValue": 30,
                  "min": 1,
                  "max": 90,
                  "width": "50%"
                },
                {
                  "fieldName": "Grace Period (Days)",
                  "fieldId": "gracePeriod",
                  "type": "number",
                  "defaultValue": 15,
                  "min": 0,
                  "max": 30,
                  "width": "50%"
                }
              ]
            },
            {
              "sectionTitle": "Late Payment Settings",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Apply Late Charges",
                  "fieldId": "applyLateCharges",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Late Charge Type",
                  "fieldId": "lateChargeType",
                  "type": "dropdown",
                  "options": ["Flat Amount", "Percentage", "Tiered"],
                  "conditional": "applyLateCharges=true",
                  "width": "50%"
                },
                {
                  "fieldName": "Late Charge Amount/Rate",
                  "fieldId": "lateChargeValue",
                  "type": "decimal",
                  "conditional": "applyLateCharges=true",
                  "width": "50%"
                },
                {
                  "fieldName": "Minimum Late Charge",
                  "fieldId": "minLateCharge",
                  "type": "decimal",
                  "defaultValue": 10.00,
                  "conditional": "applyLateCharges=true",
                  "width": "50%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "insurerSetup",
          "tabLabel": "Insurer Setup",
          "sections": [
            {
              "sectionTitle": "Direct Bill Insurers",
              "type": "editable-grid",
              "toolbar": [
                {"label": "Add Insurer", "action": "addInsurer", "icon": "plus"},
                {"label": "Import", "action": "importInsurers", "icon": "upload"}
              ],
              "columns": [
                {
                  "field": "insurerCode",
                  "header": "Insurer Code",
                  "type": "text",
                  "width": "10%",
                  "editable": true,
                  "required": true
                },
                {
                  "field": "insurerName",
                  "header": "Insurer Name",
                  "type": "text",
                  "width": "20%",
                  "editable": true,
                  "required": true
                },
                {
                  "field": "billMethod",
                  "header": "Bill Method",
                  "type": "dropdown",
                  "options": ["Direct Bill", "Account Current", "Statement"],
                  "width": "12%",
                  "editable": true
                },
                {
                  "field": "paymentTerms",
                  "header": "Payment Terms",
                  "type": "number",
                  "width": "10%",
                  "editable": true
                },
                {
                  "field": "creditLimit",
                  "header": "Credit Limit",
                  "type": "decimal",
                  "width": "12%",
                  "editable": true
                },
                {
                  "field": "contactEmail",
                  "header": "Contact Email",
                  "type": "email",
                  "width": "15%",
                  "editable": true
                },
                {
                  "field": "autoGenerate",
                  "header": "Auto Generate",
                  "type": "checkbox",
                  "width": "8%",
                  "editable": true
                },
                {
                  "field": "active",
                  "header": "Active",
                  "type": "checkbox",
                  "width": "8%",
                  "editable": true
                },
                {
                  "field": "actions",
                  "header": "",
                  "type": "row-actions",
                  "actions": ["edit", "delete"],
                  "width": "5%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "glAccounts",
          "tabLabel": "GL Mapping",
          "sections": [
            {
              "sectionTitle": "Direct Bill GL Configuration",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Receivable Account",
                  "fieldId": "receivableAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "lookupScreen": "glAccountMaster",
                  "width": "50%"
                },
                {
                  "fieldName": "Premium Account",
                  "fieldId": "premiumAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Late Charge Account",
                  "fieldId": "lateChargeAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Bad Debt Account",
                  "fieldId": "badDebtAccount",
                  "type": "text",
                  "required": true,
                  "lookupButton": true,
                  "width": "50%"
                }
              ]
            }
          ]
        }
      ]
    },
    "k14_adjustment_master": {
      "featureId": "K14-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Remittance Adjustment Master",
      "screenCode": "FIN_MAS_REM_014",
      "menuPath": "Finance > Master > Remittance Master > Adjustment Configuration",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "tabs": [
        {
          "tabId": "adjustmentTypes",
          "tabLabel": "Adjustment Types",
          "sections": [
            {
              "sectionTitle": "Adjustment Type Configuration",
              "type": "editable-grid",
              "toolbar": [
                {"label": "Add Type", "action": "addType", "icon": "plus"}
              ],
              "columns": [
                {
                  "field": "adjustmentCode",
                  "header": "Code",
                  "type": "text",
                  "width": "10%",
                  "editable": true,
                  "required": true,
                  "unique": true
                },
                {
                  "field": "adjustmentName",
                  "header": "Adjustment Name",
                  "type": "text",
                  "width": "20%",
                  "editable": true,
                  "required": true
                },
                {
                  "field": "category",
                  "header": "Category",
                  "type": "dropdown",
                  "options": ["Premium", "Commission", "Tax", "Fee", "Penalty", "Refund"],
                  "width": "12%",
                  "editable": true
                },
                {
                  "field": "adjustmentNature",
                  "header": "Nature",
                  "type": "dropdown",
                  "options": ["Debit", "Credit"],
                  "width": "10%",
                  "editable": true
                },
                {
                  "field": "glAccount",
                  "header": "GL Account",
                  "type": "text",
                  "lookupButton": true,
                  "width": "15%",
                  "editable": true
                },
                {
                  "field": "requiresApproval",
                  "header": "Requires Approval",
                  "type": "checkbox",
                  "width": "10%",
                  "editable": true
                },
                {
                  "field": "approvalLimit",
                  "header": "Auto-Approve Below",
                  "type": "decimal",
                  "width": "12%",
                  "editable": true
                },
                {
                  "field": "active",
                  "header": "Active",
                  "type": "checkbox",
                  "width": "6%",
                  "editable": true
                },
                {
                  "field": "actions",
                  "header": "",
                  "type": "row-actions",
                  "actions": ["delete"],
                  "width": "5%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "adjustmentRules",
          "tabLabel": "Adjustment Rules",
          "sections": [
            {
              "sectionTitle": "Automatic Adjustment Rules",
              "type": "rule-builder",
              "fields": [
                {
                  "fieldName": "Adjustment Rules",
                  "fieldId": "adjustmentRules",
                  "type": "conditional-rules",
                  "conditions": [
                    "Payment Delay > X Days",
                    "Amount Difference < X",
                    "Policy Status = X",
                    "Premium Type = X",
                    "Customer Category = X"
                  ],
                  "actions": [
                    "Apply Late Fee",
                    "Apply Discount",
                    "Write-off Difference",
                    "Create Credit Note",
                    "Create Debit Note"
                  ]
                }
              ]
            },
            {
              "sectionTitle": "Adjustment Limits",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "Max Adjustment Amount",
                  "fieldId": "maxAdjustmentAmount",
                  "type": "decimal",
                  "defaultValue": 10000.00,
                  "width": "33%"
                },
                {
                  "fieldName": "Max Adjustment Percentage",
                  "fieldId": "maxAdjustmentPercent",
                  "type": "percentage",
                  "defaultValue": 10,
                  "width": "33%"
                },
                {
                  "fieldName": "Adjustment Frequency Limit",
                  "fieldId": "frequencyLimit",
                  "type": "number",
                  "defaultValue": 3,
                  "helpText": "Max adjustments per policy per month",
                  "width": "33%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "approvalMatrix",
          "tabLabel": "Approval Matrix",
          "sections": [
            {
              "sectionTitle": "Adjustment Approval Limits",
              "type": "matrix-grid",
              "rows": ["User", "Supervisor", "Manager", "Finance Head", "CFO"],
              "columns": ["Premium Adjustment", "Commission Adjustment", "Tax Adjustment", "Fee Waiver", "Refund"],
              "cellType": "decimal",
              "cellFormat": "currency",
              "editable": true,
              "defaultValues": {
                "User": 100,
                "Supervisor": 1000,
                "Manager": 5000,
                "Finance Head": 25000,
                "CFO": 999999999
              }
            }
          ]
        }
      ]
    },
    "k15_notification_template_master": {
      "featureId": "K15-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Remittance Notification Master",
      "screenCode": "FIN_MAS_REM_015",
      "menuPath": "Finance > Master > Remittance Master > Notification Templates",
      "accessRoles": ["ADMIN"],
      "tabs": [
        {
          "tabId": "emailTemplates",
          "tabLabel": "Email Templates",
          "sections": [
            {
              "sectionTitle": "Template Management",
              "type": "template-list",
              "templates": [
                {
                  "code": "REM_CREATED",
                  "name": "Remittance Created",
                  "trigger": "On remittance creation",
                  "recipients": ["Insurer", "Internal Team"]
                },
                {
                  "code": "REM_APPROVED",
                  "name": "Remittance Approved",
                  "trigger": "On approval",
                  "recipients": ["Insurer", "Finance Team"]
                },
                {
                  "code": "REM_PROCESSED",
                  "name": "Remittance Processed",
                  "trigger": "On processing complete",
                  "recipients": ["Insurer", "Accounts"]
                },
                {
                  "code": "REM_PAYMENT_DUE",
                  "name": "Payment Due Reminder",
                  "trigger": "X days before due",
                  "recipients": ["Insurer"]
                },
                {
                  "code": "REM_OVERDUE",
                  "name": "Payment Overdue",
                  "trigger": "X days after due",
                  "recipients": ["Insurer", "Collections"]
                },
                {
                  "code": "REM_EXCEPTION",
                  "name": "Exception Alert",
                  "trigger": "On exception",
                  "recipients": ["Operations Team"]
                }
              ],
              "actions": ["edit", "preview", "test", "activate", "deactivate"]
            }
          ]
        },
        {
          "tabId": "templateEditor",
          "tabLabel": "Template Editor",
          "sections": [
            {
              "sectionTitle": "Template Details",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Template Code",
                  "fieldId": "templateCode",
                  "type": "text",
                  "required": true,
                  "readonly": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Template Name",
                  "fieldId": "templateName",
                  "type": "text",
                  "required": true,
                  "width": "50%"
                },
                {
                  "fieldName": "Subject Line",
                  "fieldId": "subject",
                  "type": "text",
                  "required": true,
                  "placeholder": "Use {{variables}} for dynamic content",
                  "width": "100%"
                }
              ]
            },
            {
              "sectionTitle": "Email Body",
              "fields": [
                {
                  "fieldName": "Template Body",
                  "fieldId": "templateBody",
                  "type": "rich-text-editor",
                  "toolbar": ["bold", "italic", "underline", "link", "image", "table", "variable"],
                  "variables": [
                    "{{insurerName}}",
                    "{{remittanceNo}}",
                    "{{amount}}",
                    "{{dueDate}}",
                    "{{policyCount}}",
                    "{{contactPerson}}",
                    "{{paymentLink}}"
                  ],
                  "height": "400px"
                }
              ]
            },
            {
              "sectionTitle": "Settings",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "CC Recipients",
                  "fieldId": "ccRecipients",
                  "type": "tag-input",
                  "placeholder": "Enter email addresses",
                  "width": "33%"
                },
                {
                  "fieldName": "BCC Recipients",
                  "fieldId": "bccRecipients",
                  "type": "tag-input",
                  "placeholder": "Enter email addresses",
                  "width": "33%"
                },
                {
                  "fieldName": "Reply To",
                  "fieldId": "replyTo",
                  "type": "email",
                  "defaultValue": "remittance@company.com",
                  "width": "33%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "smsTemplates",
          "tabLabel": "SMS Templates",
          "sections": [
            {
              "sectionTitle": "SMS Template Configuration",
              "type": "simple-grid",
              "columns": [
                {
                  "field": "templateCode",
                  "header": "Code",
                  "width": "15%"
                },
                {
                  "field": "templateName",
                  "header": "Name",
                  "width": "25%"
                },
                {
                  "field": "message",
                  "header": "Message",
                  "width": "40%",
                  "type": "text-area",
                  "maxLength": 160
                },
                {
                  "field": "trigger",
                  "header": "Trigger",
                  "width": "15%"
                },
                {
                  "field": "active",
                  "header": "Active",
                  "width": "5%",
                  "type": "checkbox"
                }
              ]
            }
          ]
        },
        {
          "tabId": "notificationRules",
          "tabLabel": "Notification Rules",
          "sections": [
            {
              "sectionTitle": "Trigger Configuration",
              "type": "trigger-rules",
              "rules": [
                {
                  "event": "Remittance Creation",
                  "conditions": ["Amount > X", "Insurer Type = X", "Always"],
                  "channels": ["Email", "SMS", "In-App"],
                  "timing": "Immediate"
                },
                {
                  "event": "Payment Due",
                  "conditions": ["Days Before Due = X"],
                  "channels": ["Email", "SMS"],
                  "timing": "Scheduled"
                },
                {
                  "event": "Payment Overdue",
                  "conditions": ["Days After Due = X"],
                  "channels": ["Email", "SMS", "Phone"],
                  "timing": "Scheduled",
                  "escalation": true
                }
              ]
            }
          ]
        }
      ]
    },
    "k16_history_configuration": {
      "featureId": "K16-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Remittance History Configuration",
      "screenCode": "FIN_MAS_REM_016",
      "menuPath": "Finance > Master > Remittance Master > History Settings",
      "accessRoles": ["ADMIN"],
      "tabs": [
        {
          "tabId": "archival",
          "tabLabel": "Archival Settings",
          "sections": [
            {
              "sectionTitle": "Data Retention Policy",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Online Retention Period",
                  "fieldId": "onlineRetention",
                  "type": "number",
                  "defaultValue": 24,
                  "unit": "months",
                  "width": "50%"
                },
                {
                  "fieldName": "Archive Retention Period",
                  "fieldId": "archiveRetention",
                  "type": "number",
                  "defaultValue": 84,
                  "unit": "months",
                  "width": "50%"
                },
                {
                  "fieldName": "Purge After",
                  "fieldId": "purgeAfter",
                  "type": "number",
                  "defaultValue": 120,
                  "unit": "months",
                  "width": "50%"
                },
                {
                  "fieldName": "Archive Location",
                  "fieldId": "archiveLocation",
                  "type": "dropdown",
                  "options": ["Database Archive", "File System", "Cloud Storage"],
                  "defaultValue": "Database Archive",
                  "width": "50%"
                }
              ]
            },
            {
              "sectionTitle": "Archival Schedule",
              "layout": "three-column",
              "fields": [
                {
                  "fieldName": "Run Archival",
                  "fieldId": "runArchival",
                  "type": "checkbox",
                  "defaultValue": true,
                  "width": "33%"
                },
                {
                  "fieldName": "Archival Day",
                  "fieldId": "archivalDay",
                  "type": "dropdown",
                  "options": ["Sunday", "Monday", "Saturday"],
                  "defaultValue": "Sunday",
                  "conditional": "runArchival=true",
                  "width": "33%"
                },
                {
                  "fieldName": "Archival Time",
                  "fieldId": "archivalTime",
                  "type": "time",
                  "defaultValue": "02:00",
                  "conditional": "runArchival=true",
                  "width": "33%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "auditTrail",
          "tabLabel": "Audit Trail",
          "sections": [
            {
              "sectionTitle": "Audit Configuration",
              "layout": "single-column",
              "fields": [
                {
                  "fieldName": "Enable Audit Trail",
                  "fieldId": "enableAudit",
                  "type": "checkbox",
                  "defaultValue": true
                },
                {
                  "fieldName": "Audit Events",
                  "fieldId": "auditEvents",
                  "type": "checkbox-group",
                  "options": [
                    {"value": "create", "label": "Creation", "checked": true},
                    {"value": "update", "label": "Updates", "checked": true},
                    {"value": "delete", "label": "Deletion", "checked": true},
                    {"value": "approve", "label": "Approvals", "checked": true},
                    {"value": "reject", "label": "Rejections", "checked": true},
                    {"value": "process", "label": "Processing", "checked": true},
                    {"value": "view", "label": "View/Access", "checked": false},
                    {"value": "export", "label": "Export/Download", "checked": true}
                  ],
                  "conditional": "enableAudit=true",
                  "layout": "two-column"
                }
              ]
            },
            {
              "sectionTitle": "Audit Fields",
              "type": "field-selector",
              "fields": [
                {
                  "fieldName": "Track Field Changes",
                  "fieldId": "trackFields",
                  "type": "dual-listbox",
                  "leftTitle": "Available Fields",
                  "rightTitle": "Tracked Fields",
                  "defaultSelected": [
                    "amount",
                    "status",
                    "approvalStatus",
                    "paymentMethod",
                    "bankAccount"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "k17_analytics_configuration": {
      "featureId": "K17-ADMIN",
      "screenCategory": "MASTER",
      "screenTitle": "Remittance Analytics Configuration",
      "screenCode": "FIN_MAS_REM_017",
      "menuPath": "Finance > Master > Remittance Master > Analytics Setup",
      "accessRoles": ["ADMIN", "FINANCE_MANAGER"],
      "tabs": [
        {
          "tabId": "dashboards",
          "tabLabel": "Dashboard Configuration",
          "sections": [
            {
              "sectionTitle": "Dashboard Templates",
              "type": "dashboard-designer",
              "templates": [
                {
                  "name": "Executive Dashboard",
                  "widgets": [
                    "Revenue Trend",
                    "Commission Analysis",
                    "Payment Status",
                    "Top Insurers",
                    "Exception Rate"
                  ],
                  "layout": "2x3 grid",
                  "refreshRate": "5 minutes"
                },
                {
                  "name": "Operational Dashboard",
                  "widgets": [
                    "Daily Processing",
                    "Pending Approvals",
                    "Exception Queue",
                    "SLA Performance",
                    "User Activity"
                  ],
                  "layout": "3x3 grid",
                  "refreshRate": "1 minute"
                },
                {
                  "name": "Financial Dashboard",
                  "widgets": [
                    "Cash Flow",
                    "Aging Analysis",
                    "Collection Rate",
                    "Write-offs",
                    "Reconciliation Status"
                  ],
                  "layout": "2x2 grid",
                  "refreshRate": "15 minutes"
                }
              ]
            }
          ]
        },
        {
          "tabId": "kpis",
          "tabLabel": "KPI Configuration",
          "sections": [
            {
              "sectionTitle": "Key Performance Indicators",
              "type": "kpi-grid",
              "columns": [
                {
                  "field": "kpiCode",
                  "header": "KPI Code",
                  "width": "10%",
                  "editable": true
                },
                {
                  "field": "kpiName",
                  "header": "KPI Name",
                  "width": "20%",
                  "editable": true
                },
                {
                  "field": "formula",
                  "header": "Formula",
                  "width": "25%",
                  "type": "formula-builder",
                  "editable": true
                },
                {
                  "field": "target",
                  "header": "Target",
                  "width": "10%",
                  "editable": true
                },
                {
                  "field": "threshold",
                  "header": "Threshold",
                  "width": "10%",
                  "type": "range",
                  "editable": true
                },
                {
                  "field": "frequency",
                  "header": "Calculation Frequency",
                  "width": "10%",
                  "type": "dropdown",
                  "options": ["Real-time", "Hourly", "Daily", "Weekly", "Monthly"],
                  "editable": true
                },
                {
                  "field": "alertEnabled",
                  "header": "Alert",
                  "width": "8%",
                  "type": "checkbox",
                  "editable": true
                },
                {
                  "field": "active",
                  "header": "Active",
                  "width": "7%",
                  "type": "checkbox",
                  "editable": true
                }
              ],
              "defaultKPIs": [
                {
                  "kpiCode": "REM_TAT",
                  "kpiName": "Remittance Turnaround Time",
                  "formula": "AVG(ProcessDate - CreateDate)",
                  "target": "2 days",
                  "threshold": "1-3 days"
                },
                {
                  "kpiCode": "COLL_RATE",
                  "kpiName": "Collection Rate",
                  "formula": "(Collected / Billed) * 100",
                  "target": "95%",
                  "threshold": "90-100%"
                },
                {
                  "kpiCode": "EXC_RATE",
                  "kpiName": "Exception Rate",
                  "formula": "(Exceptions / Total Transactions) * 100",
                  "target": "<5%",
                  "threshold": "0-10%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "alerts",
          "tabLabel": "Alert Configuration",
          "sections": [
            {
              "sectionTitle": "Alert Rules",
              "type": "alert-builder",
              "fields": [
                {
                  "fieldName": "Alert Conditions",
                  "fieldId": "alertConditions",
                  "type": "condition-builder",
                  "metrics": [
                    "Pending Amount > X",
                    "Overdue Days > X",
                    "Exception Count > X",
                    "Processing Time > X",
                    "Approval Pending > X hours",
                    "Collection Rate < X%"
                  ],
                  "actions": [
                    "Send Email",
                    "Send SMS",
                    "Dashboard Alert",
                    "Create Task",
                    "Escalate"
                  ],
                  "recipients": "role-based"
                }
              ]
            },
            {
              "sectionTitle": "Alert Frequency",
              "layout": "two-column",
              "fields": [
                {
                  "fieldName": "Check Frequency",
                  "fieldId": "checkFrequency",
                  "type": "dropdown",
                  "options": ["Every 5 minutes", "Every 15 minutes", "Hourly", "Daily"],
                  "defaultValue": "Every 15 minutes",
                  "width": "50%"
                },
                {
                  "fieldName": "Alert Cooldown",
                  "fieldId": "alertCooldown",
                  "type": "number",
                  "defaultValue": 60,
                  "unit": "minutes",
                  "helpText": "Minimum time between same alerts",
                  "width": "50%"
                }
              ]
            }
          ]
        },
        {
          "tabId": "dataModel",
          "tabLabel": "Data Model",
          "sections": [
            {
              "sectionTitle": "Analytics Data Configuration",
              "layout": "single-column",
              "fields": [
                {
                  "fieldName": "Data Aggregation Level",
                  "fieldId": "aggregationLevel",
                  "type": "dropdown",
                  "options": ["Transaction Level", "Daily Summary", "Weekly Summary", "Monthly Summary"],
                  "defaultValue": "Daily Summary"
                },
                {
                  "fieldName": "Historical Data Period",
                  "fieldId": "historicalPeriod",
                  "type": "dropdown",
                  "options": ["3 Months", "6 Months", "1 Year", "2 Years", "All"],
                  "defaultValue": "1 Year"
                },
                {
                  "fieldName": "Enable Data Warehouse",
                  "fieldId": "enableDataWarehouse",
                  "type": "checkbox",
                  "defaultValue": false
                },
                {
                  "fieldName": "ETL Schedule",
                  "fieldId": "etlSchedule",
                  "type": "cron-expression",
                  "defaultValue": "0 2 * * *",
                  "conditional": "enableDataWarehouse=true",
                  "helpText": "Daily at 2 AM"
                }
              ]
            }
          ]
        }
      ]
    }
  },
