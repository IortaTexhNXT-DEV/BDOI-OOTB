{
  "feature_id": "S1",
  "feature_name": "Incentive Programs",
  "description": "Setup and manage various incentive schemes for agents, brokers, and teams in the Philippines insurance market",
  "mvp_scope": {
    "included": [
      "Basic incentive program configuration",
      "Target-based incentives",
      "Commission-based incentives",
      "Program activation/deactivation",
      "Agent/broker assignment to programs"
    ],
    "excluded": [
      "Complex multi-tier calculations",
      "Retroactive adjustments",
      "API integrations",
      "Advanced analytics"
    ]
  },
  "screens": {
    "master_screen": {
      "name": "Incentive Program Master",
      "purpose": "Configure and manage incentive programs",
      "navigation": "/master/incentive/programs",
      "components": {
        "list_view": {
          "columns": ["Program Code", "Program Name", "Type", "Target Type", "Period", "Status", "Actions"],
          "filters": ["Status", "Type", "Period"],
          "actions": ["Add", "Edit", "View", "Activate/Deactivate"]
        },
        "form_view": {
          "sections": [
            {
              "name": "Basic Information",
              "fields": [
                {"field": "program_code", "type": "text", "required": true, "auto_generate": true},
                {"field": "program_name", "type": "text", "required": true},
                {"field": "description", "type": "textarea"},
                {"field": "program_type", "type": "dropdown", "options": ["Commission Based", "Target Based", "Hybrid"], "required": true},
                {"field": "applicable_to", "type": "multiselect", "options": ["Individual Agent", "Team", "Branch", "Region"]}
              ]
            },
            {
              "name": "Program Period",
              "fields": [
                {"field": "start_date", "type": "date", "required": true},
                {"field": "end_date", "type": "date", "required": true},
                {"field": "calculation_frequency", "type": "dropdown", "options": ["Monthly", "Quarterly", "Semi-Annual", "Annual"]}
              ]
            },
            {
              "name": "Target Configuration",
              "fields": [
                {"field": "target_metric", "type": "dropdown", "options": ["Premium Volume", "Policy Count", "New Business", "Renewal Rate"]},
                {"field": "base_target", "type": "number", "required": true},
                {"field": "stretch_target", "type": "number"},
                {"field": "currency", "type": "dropdown", "options": ["PHP"], "default": "PHP"}
              ]
            },
            {
              "name": "Incentive Structure",
              "type": "grid",
              "columns": [
                {"field": "achievement_level", "type": "text", "example": "100-110%"},
                {"field": "incentive_type", "type": "dropdown", "options": ["Fixed Amount", "Percentage"]},
                {"field": "incentive_value", "type": "number"},
                {"field": "max_payout", "type": "number"}
              ]
            }
          ]
        }
      }
    },
    "user_screen": {
      "name": "My Incentive Programs",
      "purpose": "View assigned incentive programs and progress",
      "navigation": "/incentive/my-programs",
      "components": {
        "dashboard_view": {
          "sections": [
            {
              "name": "Active Programs",
              "type": "cards",
              "displays": ["Program Name", "Target", "Current Achievement", "Potential Earning", "Days Remaining"]
            },
            {
              "name": "Achievement Progress",
              "type": "progress_bars",
              "metrics": ["Premium Target", "Policy Count", "Overall Performance"]
            },
            {
              "name": "Recent Activities",
              "type": "table",
              "columns": ["Date", "Activity", "Impact on Target", "Points Earned"]
            }
          ]
        }
      }
    }
  },
  "data_model": {
    "incentive_program": {
      "program_id": "string",
      "program_code": "string",
      "program_name": "string",
      "program_type": "enum",
      "target_metric": "string",
      "base_target": "number",
      "stretch_target": "number",
      "start_date": "date",
      "end_date": "date",
      "status": "enum",
      "created_by": "string",
      "created_date": "timestamp"
    },
    "program_assignment": {
      "assignment_id": "string",
      "program_id": "string",
      "agent_id": "string",
      "team_id": "string",
      "effective_date": "date",
      "status": "enum"
    }
  },
  "business_rules": [
    "Programs cannot have overlapping periods for the same agent",
    "Minimum achievement threshold is 80% for payout eligibility",
    "Maximum payout cap applies to prevent calculation errors",
    "Programs must be approved before activation",
    "Historical data cannot be modified after period closure"
  ]
}