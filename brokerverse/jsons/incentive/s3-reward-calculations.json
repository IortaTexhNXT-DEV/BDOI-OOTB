{
  "feature_id": "S3",
  "feature_name": "Reward Calculations",
  "description": "Calculate and process incentive rewards based on performance metrics and configured programs",
  "mvp_scope": {
    "included": [
      "Automated calculation engine",
      "Manual calculation trigger",
      "Calculation preview",
      "Approval workflow for payouts",
      "Basic adjustments"
    ],
    "excluded": [
      "Complex formula builder",
      "Real-time calculations",
      "Multi-currency support",
      "Integration with payroll systems"
    ]
  },
  "screens": {
    "calculation_screen": {
      "name": "Incentive Calculation",
      "purpose": "Run and manage incentive calculations",
      "navigation": "/incentive/calculations",
      "components": {
        "calculation_wizard": {
          "steps": [
            {
              "step": 1,
              "name": "Select Period",
              "fields": [
                {"field": "calculation_period", "type": "month_picker", "required": true},
                {"field": "program_filter", "type": "multiselect", "label": "Programs to Calculate"},
                {"field": "agent_filter", "type": "multiselect", "label": "Specific Agents (Optional)"}
              ]
            },
            {
              "step": 2,
              "name": "Review Metrics",
              "components": [
                {
                  "type": "summary_cards",
                  "metrics": ["Total Premium Collected", "Policies Sold", "Active Agents", "Average Achievement"]
                },
                {
                  "type": "data_table",
                  "columns": ["Agent Name", "Program", "Target", "Achievement", "Achievement %", "Status"]
                }
              ]
            },
            {
              "step": 3,
              "name": "Calculate Rewards",
              "components": [
                {
                  "type": "action_buttons",
                  "actions": ["Run Calculation", "Preview Results"]
                },
                {
                  "type": "progress_indicator",
                  "stages": ["Fetching Data", "Applying Rules", "Computing Rewards", "Validation", "Complete"]
                }
              ]
            },
            {
              "step": 4,
              "name": "Review & Approve",
              "components": [
                {
                  "type": "results_table",
                  "columns": ["Agent", "Base Earning", "Bonus", "Deductions", "Net Incentive", "Status"],
                  "features": ["inline_edit", "add_adjustment", "add_note"]
                },
                {
                  "type": "summary_section",
                  "displays": ["Total Payout", "Pending Approvals", "Exceptions"]
                }
              ]
            }
          ]
        },
        "adjustments_panel": {
          "name": "Adjustments",
          "fields": [
            {"field": "adjustment_type", "type": "dropdown", "options": ["Bonus", "Deduction", "Correction"]},
            {"field": "amount", "type": "number", "required": true},
            {"field": "reason", "type": "textarea", "required": true},
            {"field": "supporting_document", "type": "file_upload"}
          ]
        }
      }
    },
    "approval_screen": {
      "name": "Incentive Approvals",
      "purpose": "Review and approve calculated incentives",
      "navigation": "/incentive/approvals",
      "components": {
        "pending_approvals": {
          "type": "data_table",
          "columns": ["Batch ID", "Period", "Total Amount", "Agent Count", "Submitted By", "Submitted Date", "Actions"],
          "row_actions": ["View Details", "Approve", "Reject", "Request Changes"]
        },
        "approval_details": {
          "sections": [
            {
              "name": "Batch Summary",
              "fields": ["Period", "Programs Included", "Total Payout", "Agent Count"]
            },
            {
              "name": "Agent Details",
              "type": "expandable_table",
              "columns": ["Agent", "Program", "Achievement", "Calculated Amount", "Adjustments", "Final Amount"]
            },
            {
              "name": "Approval Actions",
              "buttons": ["Approve All", "Approve Selected", "Reject", "Send Back for Review"]
            }
          ]
        }
      }
    }
  },
  "data_model": {
    "calculation_batch": {
      "batch_id": "string",
      "period": "string",
      "calculation_date": "timestamp",
      "programs_included": "array",
      "total_amount": "number",
      "status": "enum",
      "approved_by": "string",
      "approval_date": "timestamp"
    },
    "calculation_detail": {
      "detail_id": "string",
      "batch_id": "string",
      "agent_id": "string",
      "program_id": "string",
      "target_value": "number",
      "achieved_value": "number",
      "achievement_percentage": "number",
      "base_incentive": "number",
      "adjustments": "number",
      "final_amount": "number",
      "status": "enum"
    }
  },
  "business_rules": [
    "Calculations must be run sequentially by period",
    "Previous period must be approved before calculating next",
    "Adjustments require supervisor approval",
    "Negative incentives are not allowed",
    "Calculations are locked after approval"
  ]
}