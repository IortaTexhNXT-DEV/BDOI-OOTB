{
  "feature_id": "S4",
  "feature_name": "Incentive Reports",
  "description": "Generate and view various reports related to incentive programs, calculations, and payouts",
  "mvp_scope": {
    "included": [
      "Standard report templates",
      "Period-wise payout reports",
      "Agent performance reports",
      "Program effectiveness reports",
      "Export to Excel/PDF"
    ],
    "excluded": [
      "Custom report builder",
      "Real-time dashboards",
      "Predictive analytics",
      "API-based report distribution"
    ]
  },
  "screens": {
    "reports_dashboard": {
      "name": "Incentive Reports",
      "purpose": "Access and generate various incentive reports",
      "navigation": "/incentive/reports",
      "components": {
        "report_categories": {
          "type": "tab_view",
          "tabs": [
            {
              "name": "Payout Reports",
              "reports": [
                {
                  "name": "Monthly Payout Summary",
                  "description": "Summary of incentives paid by month",
                  "parameters": ["Period", "Program", "Branch"],
                  "format": ["PDF", "Excel"]
                },
                {
                  "name": "Agent Payout Details",
                  "description": "Detailed breakdown of individual agent payouts",
                  "parameters": ["Agent", "Date Range", "Program"],
                  "format": ["PDF", "Excel"]
                },
                {
                  "name": "Pending Payouts",
                  "description": "List of calculated but unpaid incentives",
                  "parameters": ["Status", "Program"],
                  "format": ["Excel"]
                }
              ]
            },
            {
              "name": "Performance Reports",
              "reports": [
                {
                  "name": "Target Achievement Report",
                  "description": "Achievement levels across programs and agents",
                  "parameters": ["Period", "Program", "Minimum Achievement %"],
                  "format": ["PDF", "Excel"],
                  "visualizations": ["Bar Chart", "Heat Map"]
                },
                {
                  "name": "Top Performers",
                  "description": "Ranking of top performing agents",
                  "parameters": ["Period", "Top N", "Program"],
                  "format": ["PDF"],
                  "visualizations": ["Leaderboard"]
                },
                {
                  "name": "Performance Trends",
                  "description": "Historical performance trends",
                  "parameters": ["Date Range", "Agent/Team", "Metric"],
                  "format": ["PDF", "Excel"],
                  "visualizations": ["Line Chart"]
                }
              ]
            },
            {
              "name": "Program Analysis",
              "reports": [
                {
                  "name": "Program Effectiveness",
                  "description": "Analysis of program impact on sales",
                  "parameters": ["Program", "Date Range"],
                  "format": ["PDF"],
                  "metrics": ["ROI", "Participation Rate", "Average Payout", "Sales Lift"]
                },
                {
                  "name": "Budget vs Actual",
                  "description": "Comparison of budgeted vs actual payouts",
                  "parameters": ["Period", "Program"],
                  "format": ["Excel"],
                  "visualizations": ["Variance Chart"]
                }
              ]
            }
          ]
        },
        "report_viewer": {
          "features": [
            "Preview before download",
            "Email report",
            "Schedule recurring reports",
            "Save report parameters as template"
          ]
        }
      }
    },
    "agent_statement": {
      "name": "Incentive Statement",
      "purpose": "Individual agent incentive statement",
      "navigation": "/incentive/statement",
      "components": {
        "statement_header": {
          "displays": ["Agent Name", "Agent Code", "Period", "Statement Date"]
        },
        "earnings_summary": {
          "type": "cards",
          "metrics": [
            {"label": "Total Earnings", "value": "calculated"},
            {"label": "YTD Earnings", "value": "calculated"},
            {"label": "Pending Payment", "value": "calculated"},
            {"label": "Last Payment", "value": "calculated"}
          ]
        },
        "program_details": {
          "type": "accordion",
          "sections": [
            {
              "name": "Program-wise Breakdown",
              "type": "table",
              "columns": ["Program", "Target", "Achievement", "Rate", "Earned Amount"]
            },
            {
              "name": "Monthly Trend",
              "type": "chart",
              "chart_type": "line",
              "data": "Last 12 months earnings"
            }
          ]
        },
        "actions": {
          "buttons": ["Download PDF", "Email Statement", "View History"]
        }
      }
    }
  },
  "report_templates": {
    "monthly_payout_summary": {
      "sections": [
        {"type": "header", "content": "Company Logo, Report Title, Period"},
        {"type": "summary", "metrics": ["Total Payout", "Agent Count", "Average Payout"]},
        {"type": "table", "data": "Payout details by program"},
        {"type": "chart", "visualization": "Distribution chart"},
        {"type": "footer", "content": "Generated date, Approver signature"}
      ]
    }
  },
  "data_model": {
    "report_schedule": {
      "schedule_id": "string",
      "report_name": "string",
      "parameters": "json",
      "frequency": "enum",
      "recipients": "array",
      "format": "enum",
      "last_run": "timestamp",
      "next_run": "timestamp",
      "status": "enum"
    },
    "report_history": {
      "history_id": "string",
      "report_name": "string",
      "generated_by": "string",
      "generated_date": "timestamp",
      "parameters_used": "json",
      "file_path": "string"
    }
  },
  "business_rules": [
    "Agents can only view their own statements",
    "Managers can view team reports",
    "Financial reports require special permissions",
    "Reports are archived for 7 years",
    "Scheduled reports run at off-peak hours"
  ]
}