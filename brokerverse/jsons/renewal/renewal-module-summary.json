{
  "module_name": "Renewal Management System",
  "module_code": "H",
  "description": "Comprehensive renewal management system for Philippines insurance brokers to maximize retention and optimize renewal operations",
  "business_context": {
    "market": "Philippines Insurance Brokerage",
    "challenges": [
      "High competition leading to policy lapses",
      "Manual renewal processes causing delays",
      "Lack of visibility into at-risk policies",
      "Inconsistent renewal pricing and negotiations",
      "Poor tracking of renewal performance"
    ],
    "objectives": [
      "Achieve 85%+ renewal retention rate",
      "Reduce renewal cycle time to under 15 days",
      "Identify and save 50% of at-risk policies",
      "Standardize renewal pricing and approval process",
      "Enable data-driven renewal strategies"
    ]
  },
  "implementation_plan": {
    "phase_1": {
      "name": "Foundation",
      "duration": "2 weeks",
      "features": [
        "H3: Renewal Queue Dashboard",
        "H3: Basic Quote Generation",
        "H4: Retention Metrics Dashboard"
      ],
      "deliverables": [
        "Core renewal tracking",
        "Simple quote generation",
        "Basic analytics"
      ]
    },
    "phase_2": {
      "name": "Enhancement",
      "duration": "2 weeks",
      "features": [
        "H3: Advanced Quote Builder with Retention Offers",
        "H6: Negotiation Workspace",
        "H7: Lapse Management Dashboard"
      ],
      "deliverables": [
        "Sophisticated pricing tools",
        "Negotiation tracking",
        "Lapse prevention"
      ]
    },
    "phase_3": {
      "name": "Optimization",
      "duration": "1 week",
      "features": [
        "H4: At-Risk Analysis",
        "H7: Win-back Campaigns",
        "H10: Performance Scorecards"
      ],
      "deliverables": [
        "Predictive analytics",
        "Automated campaigns",
        "Performance management"
      ]
    }
  },
  "feature_integration": {
    "H3_renewal_quotes": {
      "integrates_with": [
        "Policy Management (for policy data)",
        "Pricing Engine (for premium calculation)",
        "Document Management (for quote generation)"
      ],
      "data_flow": "Policy → Quote → Approval → Delivery"
    },
    "H4_retention_analytics": {
      "integrates_with": [
        "BI/Reporting (for analytics)",
        "CRM (for customer data)",
        "Claims (for claims history)"
      ],
      "data_flow": "Historical Data → Analytics → Insights → Actions"
    },
    "H6_negotiation_tracking": {
      "integrates_with": [
        "CRM (for communication logs)",
        "Approval Workflow (for special terms)",
        "Document Management (for correspondence)"
      ],
      "data_flow": "Client Contact → Negotiation → Approval → Closure"
    },
    "H7_lapse_management": {
      "integrates_with": [
        "Payment System (for payment status)",
        "Communication Platform (for outreach)",
        "Underwriting (for reinstatement)"
      ],
      "data_flow": "Payment Due → Grace Period → Lapse → Win-back"
    },
    "H10_performance_tracking": {
      "integrates_with": [
        "HR System (for agent data)",
        "Incentive Module (for rewards)",
        "Training System (for development plans)"
      ],
      "data_flow": "Activities → Metrics → Evaluation → Improvement"
    }
  },
  "key_workflows": {
    "standard_renewal": {
      "steps": [
        "System identifies policies expiring in 90 days",
        "Generate renewal quotes automatically",
        "Agent reviews and adjusts quote",
        "Send quote to client 60 days before expiry",
        "Follow up at 45, 30, 15 days",
        "Negotiate if needed",
        "Process renewal or handle lapse"
      ],
      "sla": "15 days from first contact to closure"
    },
    "at_risk_renewal": {
      "steps": [
        "System flags policy as at-risk",
        "Assign to retention specialist",
        "Analyze risk factors",
        "Prepare retention offer",
        "Manager approval for special terms",
        "Personal outreach to client",
        "Track negotiation progress",
        "Close with retention/lapse decision"
      ],
      "sla": "7 days for high-risk policies"
    },
    "lapse_recovery": {
      "steps": [
        "Policy enters grace period",
        "Automated reminders sent",
        "Agent makes personal contact",
        "Offer payment arrangements",
        "If lapsed, initiate win-back",
        "Create targeted offer",
        "Process reinstatement if successful"
      ],
      "sla": "24 hours for first contact in grace period"
    }
  },
  "success_metrics": {
    "primary_kpis": [
      {
        "metric": "Renewal Retention Rate",
        "target": "85%",
        "calculation": "Renewed Policies / Due for Renewal"
      },
      {
        "metric": "Premium Retention Rate",
        "target": "88%",
        "calculation": "Renewed Premium / Expiring Premium"
      },
      {
        "metric": "Average Cycle Time",
        "target": "<15 days",
        "calculation": "Days from First Contact to Decision"
      }
    ],
    "secondary_kpis": [
      {
        "metric": "At-Risk Save Rate",
        "target": "50%",
        "calculation": "Saved At-Risk / Total At-Risk"
      },
      {
        "metric": "Win-back Success Rate",
        "target": "25%",
        "calculation": "Reinstated / Total Lapsed"
      },
      {
        "metric": "Customer Satisfaction",
        "target": "4.5/5",
        "calculation": "Average Survey Score"
      }
    ]
  },
  "user_roles": {
    "renewal_specialist": {
      "access": ["Queue Dashboard", "Quote Generation", "Negotiation Tracking"],
      "responsibilities": ["Manage renewals", "Generate quotes", "Handle negotiations"]
    },
    "retention_manager": {
      "access": ["All Features", "Analytics", "Approvals"],
      "responsibilities": ["Oversee retention", "Approve special terms", "Analyze performance"]
    },
    "agent": {
      "access": ["Assigned Policies", "Basic Quotes", "Communication Log"],
      "responsibilities": ["Contact clients", "Process standard renewals", "Update status"]
    },
    "executive": {
      "access": ["Executive Dashboard", "Analytics", "Reports"],
      "responsibilities": ["Monitor performance", "Set strategies", "Review metrics"]
    }
  },
  "technology_requirements": {
    "frontend": [
      "React with TypeScript",
      "PrimeReact UI components",
      "Chart.js for visualizations",
      "Responsive design for mobile"
    ],
    "backend": [
      "Node.js API (future)",
      "PostgreSQL database (future)",
      "Redis for caching (future)",
      "Message queue for notifications (future)"
    ],
    "integrations": [
      "Email/SMS gateway",
      "Document generation",
      "Payment gateway",
      "BI tools"
    ]
  }
}