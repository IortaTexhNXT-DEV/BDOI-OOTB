// Defect life cycle (Test Strategy). Render from docs/package/tools: python3 qa-diagrams/render.py
digraph G {
  rankdir=TB; nodesep=0.5; ranksep=0.8;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#0B2A4A", fillcolor="#E8EEF5"];
  edge [color="#0B2A4A", fontname="Helvetica", fontsize=9];
  new [label="New\nsteps, request ID,\nevidence"];
  tri [label="Triaged\nseverity and\npriority confirmed"];
  asg [label="Assigned\nto a developer"];
  fix [label="Fixed\nautomated test added,\nCI green"];
  ret [label="Ready for re-test\nbuild deployed"];
  clo [label="Closed", fillcolor="#DCEFE3"];
  rej [label="Rejected or by design\nreason recorded", fillcolor="#FFF2CC"];
  def [label="Deferred\nworkaround and\ntarget release", fillcolor="#FFF2CC"];
  new -> tri; tri -> asg; asg -> fix; fix -> ret;
  ret -> clo [label="re-test passed"];
  ret -> asg [label="re-test failed"];
  tri -> rej;
  tri -> def [label="severity 3 or 4\nonly"];
  def -> asg [label="scheduled"];
  {rank=same; new; tri; asg; fix;}
  {rank=same; rej; def; ret; clo;}
}
