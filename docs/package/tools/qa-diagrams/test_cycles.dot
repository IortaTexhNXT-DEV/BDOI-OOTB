// Test cycles of a broker implementation (Test Plan). Render from docs/package/tools: python3 qa-diagrams/render.py
digraph G {
  rankdir=TB; nodesep=0.3; ranksep=0.5;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#0B2A4A", fillcolor="#E8EEF5"];
  edge [color="#0B2A4A", fontname="Helvetica", fontsize=9];
  sit1 [label="SIT cycle 1\nconfigured flows,\nsynthetic data"];
  sit2 [label="SIT cycle 2\nfixes, migrated data\nof the latest mock load"];
  uat1 [label="UAT cycle 1\nUAT scripts per role,\nbroker's own data"];
  uat2 [label="UAT cycle 2\nre-test, broker scenarios,\nsign-off"];
  reg [label="Regression\nCI suites on the\nrelease tag"];
  reh [label="Go-live rehearsal\nPre-Prod, mock load\nas cutover rehearsal"];
  cut [label="Cutover\nverification\nProduction"];
  hyp [label="Hypercare\nfirst receipts, remittances,\nfirst month-end close", fillcolor="#DCEFE3"];
  sit1 -> sit2 -> uat1 -> uat2 -> reg -> reh -> cut -> hyp;
  {rank=same; sit1; sit2; uat1; uat2;}
  {rank=same; reg; reh; cut; hyp;}
}
