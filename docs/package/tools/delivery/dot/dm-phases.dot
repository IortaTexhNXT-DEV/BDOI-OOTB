 "INP" -> "MIG" [color="#555F6D", penwidth=1.1];
 "REG" -> "CMP" [color="#555F6D", penwidth=1.1];
 "INP" -> "INT" [color="#555F6D", penwidth=1.1];
 "CFG" -> "SIT" [color="#C00000", penwidth=2.4];
 "CMP" -> "SIT" [color="#555F6D", penwidth=1.1];
