digraph G {
 rankdir=TB; dpi=170; bgcolor="white"; nodesep=0.25; ranksep=0.45; nodesep=0.15; ranksep=0.35;
 node [fontname="DejaVu Sans", fontsize=10, margin="0.10,0.06"]; edge [fontname="DejaVu Sans", arrowsize=0.7];
 "MOB" [label="Mobilisation", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "ENV" [label="Environments and\npipeline (Dev, SIT, UAT,\nProduction; GitHub\nEnvironments; secrets\nand keys)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "DIS" [label="Discovery and fit-gap\n(process, compliance,\nintegration and branding\nworkshops)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "INP" [label="Client inputs (masters,\nchart of accounts,\nusers, banks, COC\nseries, images)", fontsize=12, shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", penwidth=1.2];
 "REG" [label="Regulatory registrations\n(BIR ATP or CAS, EIS;\nAMLC; IC licences; NPC)", fontsize=12, shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", penwidth=1.2];
 "CFG" [label="Configuration (go-live\nconfiguration kit,\nProduct Configurator,\nposting rules)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "CMP" [label="Compliance set-up\n(AML/CFT, IC registers,\ncomplaints, breaches,\nmasking)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "BRD" [label="Branding and brand pack\n(theme, documents,\ne-mails, e-signatures)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "INT" [label="Integrations with\npartners (banks, SMS,\nCTPL and LTO, insurers,\ngateway, EIS)", fontsize=12, shape=box, style="rounded,filled", color="#BF8F00", fillcolor="#FFF2CC", penwidth=1.2];
 "MIG" [label="Data migration\n(migration kit, mock\nloads, reconciliation)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "TRN" [label="Training (train-the-\ntrainer, compliance\nofficer, end users)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "SIT" [label="System integration test\n(Dev, or SIT for large)", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "UAT" [label="User acceptance test and\nsign-off", fontsize=12, shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", penwidth=1.2];
 "PRD" [label="Release and frozen\nconfiguration to\nProduction", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "REH" [label="Pre-Prod from a\nproduction backup;\ncutover rehearsal", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "GNG" [label="Go/no-go", fontsize=12, shape=box, style="rounded,filled", color="#C00000", fillcolor="#FBE3E3", penwidth=2];
 "CUT" [label="Cutover and go-live lock", fontsize=12, shape=box, style="rounded,filled", color="#C00000", fillcolor="#FBE3E3", penwidth=2];
 "HYP" [label="Hypercare to the first\nmonth-end close;\nhandover", fontsize=12, shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", penwidth=1.2];
 "MOB" -> "ENV" [color="#555F6D", penwidth=1.1];
