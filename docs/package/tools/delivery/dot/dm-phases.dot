  "lg1" -> "lg2" [style=invis];
  "lg3" [label="Regulator lead time", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontsize=9];
  "lg2" -> "lg3" [style=invis];
  "lg4" [label="Gate; red arrows:\nusual critical path", shape=box, style="rounded,filled", color="#C00000", fillcolor="#FBE3E3", fontsize=9];
