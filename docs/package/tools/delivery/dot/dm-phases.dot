 "SIT" -> "TRN" [color="#555F6D", penwidth=1.1];
 "SIT" -> "UAT" [color="#C00000", penwidth=2.4];
 "MIG" -> "UAT" [color="#555F6D", penwidth=1.1];
 "TRN" -> "UAT" [color="#555F6D", penwidth=1.1];
 "UAT" -> "PRD" [color="#C00000", penwidth=2.4];
 "REG" -> "PRD" [color="#555F6D", penwidth=1.1];
 "ENV" -> "PRD" [color="#555F6D", penwidth=1.1];
 "PRD" -> "REH" [color="#C00000", penwidth=2.4];
 "MIG" -> "REH" [color="#555F6D", penwidth=1.1];
 "REH" -> "GNG" [color="#C00000", penwidth=2.4];
 "UAT" -> "GNG" [color="#C00000", penwidth=2.4];
 "TRN" -> "GNG" [color="#555F6D", penwidth=1.1];
 "CMP" -> "GNG" [color="#555F6D", penwidth=1.1];
 "GNG" -> "CUT" [color="#C00000", penwidth=2.4];
 "CUT" -> "HYP" [color="#C00000", penwidth=2.4];
 "INT" -> "HYP" [color="#BF8F00", penwidth=1.1, label="features switched\non when certified", fontsize=9, fontcolor="#BF8F00", style=dashed];
 subgraph cluster_legend { label="Legend"; fontname="DejaVu Sans"; fontsize=10; color="#BFC7D1"; style=rounded;
  "lg0" [label="iorta TechNXT", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontsize=9];
  "lg1" [label="Broker", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontsize=9];
  "lg0" -> "lg1" [style=invis];
