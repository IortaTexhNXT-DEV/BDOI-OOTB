digraph G {
 rankdir=LR; dpi=170; bgcolor="white"; nodesep=0.25; ranksep=0.45; 
 node [fontname="DejaVu Sans", fontsize=10, margin="0.10,0.06"]; edge [fontname="DejaVu Sans", arrowsize=0.7];
 subgraph cluster_in { label="Client inputs (broker)"; fontname="DejaVu Sans"; color="#548235"; style=rounded;
 "I1" [label="Insurers, agreements,\ncommission rates, products", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I2" [label="Chart of accounts and mapping", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I3" [label="User list, roles, reporting\nlines", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I4" [label="SMTP mailbox", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I5" [label="Bank accounts, statement\nsamples, payee accounts", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I7" [label="COC series from insurers", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I8" [label="Logo, sign-in picture,\nsignatories and consents", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "G1" [label="Data extracts: clients,\npolicies, open items, open\nclaims, trial balance", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I10" [label="UAT testers, sign-off\nauthority", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "I9" [label="Training rooms and attendees", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 }
 "C1" [label="Configuration kit filled\nand loaded", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "N1" [label="E-mail tested", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "N2" [label="Bank statement imports", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "N3" [label="Bank payment files", shape=box, style="rounded,filled", color="#BF8F00", fillcolor="#FFF2CC", fontcolor="#101820", penwidth=1.2];
 "N5" [label="CTPL authentication", shape=box, style="rounded,filled", color="#BF8F00", fillcolor="#FFF2CC", fontcolor="#101820", penwidth=1.2];
 "B1" [label="Branding, documents,\ne-signatures", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "G3" [label="Mock load 1 and later\nloads", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "T4" [label="UAT", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "L3" [label="End-user training", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "X4" [label="Go/no-go", shape=box, style="rounded,filled,bold", color="#C00000", fillcolor="#FBE3E3", fontcolor="#101820", penwidth=2.2];
 "I1" -> "C1" [color="#C00000", penwidth=2.4];
 "I2" -> "C1" [color="#C00000", penwidth=2.4];
 "I3" -> "C1" [color="#C00000", penwidth=2.4];
 "I4" -> "N1" [color="#555F6D", penwidth=1.1];
 "I5" -> "N2" [color="#555F6D", penwidth=1.1];
 "I5" -> "N3" [color="#555F6D", penwidth=1.1];
 "I7" -> "N5" [color="#555F6D", penwidth=1.1];
 "I8" -> "B1" [color="#555F6D", penwidth=1.1];
 "G1" -> "G3" [color="#555F6D", penwidth=1.1];
 "I10" -> "T4" [color="#555F6D", penwidth=1.1];
 "I9" -> "L3" [color="#555F6D", penwidth=1.1];
 "C1" -> "T4" [color="#C00000", penwidth=2.4];
 "G3" -> "X4" [color="#555F6D", penwidth=1.1];
 "T4" -> "X4" [color="#C00000", penwidth=2.4];
 "L3" -> "X4" [color="#555F6D", penwidth=1.1];
 "N1" -> "X4" [color="#555F6D", penwidth=1.1];
 "N2" -> "X4" [color="#555F6D", penwidth=1.1];
 "B1" -> "X4" [color="#555F6D", penwidth=1.1];
 "N3" -> "X4" [color="#BF8F00", penwidth=1.1, label="fallback: cheques", fontsize=9, fontcolor="#BF8F00", style=dashed];
 "N5" -> "X4" [color="#BF8F00", penwidth=1.1, label="fallback: code\nfrom the provider\nportal", fontsize=9, fontcolor="#BF8F00", style=dashed];
}
