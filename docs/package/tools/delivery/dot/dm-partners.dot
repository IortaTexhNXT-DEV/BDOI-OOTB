 "bank_p" -> "bank_c" [color="#555F6D", penwidth=1.1];
 "bank_c" -> "bank_f" [color="#555F6D", penwidth=1.1, label="live", fontsize=9, fontcolor="#555F6D"];
 "bank_p" -> "bank_b" [color="#7F7F7F", penwidth=1.1, label="if late", fontsize=9, fontcolor="#7F7F7F", style=dashed];
 { rank=same; "bank_f"; "bank_b"; }
