 "bank_p" [label="Banks", shape=box, style="rounded,filled", color="#BF8F00", fillcolor="#FFF2CC", fontcolor="#101820", penwidth=1.2];
 "bank_c" [label="Layout validated with the\nbank; test file accepted", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
