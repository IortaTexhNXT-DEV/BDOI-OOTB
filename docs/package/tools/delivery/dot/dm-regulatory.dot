digraph G {
 rankdir=LR; dpi=170; bgcolor="white"; nodesep=0.25; ranksep=0.45; 
 node [fontname="DejaVu Sans", fontsize=10, margin="0.10,0.06"]; edge [fontname="DejaVu Sans", arrowsize=0.7];
 "bir" [label="BIR: Authority to Print or\nCAS registration; invoice\nserial range", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "bir2" [label="invoice.* settings;\nNumbering sheet; CAS books\nreadiness", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "eis" [label="BIR: EIS enrolment and\ncertification", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "eis2" [label="EIS connector live (eis.mode\nlive)", shape=box, style="rounded,filled", color="#BF8F00", fillcolor="#FFF2CC", fontcolor="#101820", penwidth=1.2];
 "amlc" [label="AMLC: registration as\ncovered person; portal\naccess; institution code", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "amlc2" [label="CTR test file;\naml.amlc_institution_code", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "lists" [label="Screening lists: UN, AMLC,\nPEP licence", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "lists2" [label="Lists loaded; clients\nrescreened", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "ic" [label="IC: licences of the firm,\nofficers, agents; insurer\ncertificates of authority", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "ic2" [label="Licence register; insurer\nauthority (warn, then block)", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "npc" [label="NPC: DPO and data processing\nsystems registered", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "npc2" [label="privacy.notice_version;\nbreach register owner", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "tax" [label="Tax adviser confirmation of\ncodes, ATC, rates, wording", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontcolor="#101820", penwidth=1.2];
 "prod" [label="Release to Production", shape=box, style="rounded,filled,bold", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=2.2];
 "uat" [label="UAT sign-off", shape=box, style="rounded,filled,bold", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=2.2];
 "gng" [label="Go/no-go", shape=box, style="rounded,filled,bold", color="#C00000", fillcolor="#FBE3E3", fontcolor="#101820", penwidth=2.2];
 "pay" [label="Commission payouts to\nagents (licence check:\nblock)", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "after" [label="After go-live, when\nenrolled", shape=box, style="rounded,filled", color="#7F7F7F", fillcolor="#F2F2F2", fontcolor="#101820", penwidth=1.2];
 "bir" -> "bir2" [color="#555F6D", penwidth=1.1];
 "bir2" -> "prod" [color="#C00000", penwidth=2.4];
 "prod" -> "gng" [color="#C00000", penwidth=2.4];
 "eis" -> "eis2" [color="#555F6D", penwidth=1.1];
 "eis2" -> "after" [color="#7F7F7F", penwidth=1.1, style=dashed];
 "amlc" -> "amlc2" [color="#555F6D", penwidth=1.1];
 "amlc2" -> "gng" [color="#C00000", penwidth=2.4];
 "lists" -> "lists2" [color="#555F6D", penwidth=1.1];
 "lists2" -> "gng" [color="#C00000", penwidth=2.4];
 "ic" -> "ic2" [color="#555F6D", penwidth=1.1];
 "ic2" -> "gng" [color="#C00000", penwidth=2.4];
 "ic2" -> "pay" [color="#548235", penwidth=1.1, label="agents without a\nlicence are\nblocked", fontsize=9, fontcolor="#548235"];
 "npc" -> "npc2" [color="#555F6D", penwidth=1.1];
 "npc2" -> "gng" [color="#C00000", penwidth=2.4];
 "tax" -> "uat" [color="#C00000", penwidth=2.4];
 "uat" -> "gng" [color="#C00000", penwidth=2.4];
 subgraph cluster_legend { label="Legend"; fontname="DejaVu Sans"; fontsize=10; color="#BFC7D1"; style=rounded;
  "lg0" [label="Registration with a\nregulator (broker;\nlead time)", shape=box, style="rounded,filled", color="#7030A0", fillcolor="#EDE1F5", fontsize=9];
  "lg1" [label="Set-up in\nBrokerVerse", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontsize=9];
  "lg0" -> "lg1" [style=invis];
  "lg2" [label="Go/no-go gate", shape=box, style="rounded,filled", color="#C00000", fillcolor="#FBE3E3", fontsize=9];
  "lg1" -> "lg2" [style=invis];
 }
}
