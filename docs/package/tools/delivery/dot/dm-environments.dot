digraph G {
 rankdir=TB; dpi=170; bgcolor="white"; nodesep=0.25; ranksep=0.45; 
 node [fontname="DejaVu Sans", fontsize=10, margin="0.10,0.06"]; edge [fontname="DejaVu Sans", arrowsize=0.7];
 "host" [label="Hosting option,\nenvironment set and data\nlocation decided", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "dev" [label="Dev provisioned", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "sit" [label="SIT provisioned (large,\nenterprise)", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "uat" [label="UAT provisioned", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "gh" [label="GitHub Environments dev, sit,\nuat, preprod, production:\nreviewers, tag rules,\nvariables, environment secrets", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "sec" [label="Secret store per environment:\nJWT_SECRET,\nDATA_ENCRYPTION_KEY,\nPII_ENCRYPTION_KEY, SMTP_URL,\npartner credentials", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "key" [label="Key custody: escrow copy\nunder dual control; key kept\nwith the backups; rotation\nprocedure", shape=box, style="rounded,filled", color="#548235", fillcolor="#E2EFDA", fontcolor="#101820", penwidth=1.2];
 "ci" [label="CI green; first deploy and\nsmoke test", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "kit" [label="Configuration kit loaded\n(Dev or SIT); promoted to\nUAT", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "prod" [label="Production at production\ntopology; backups; restore\ntest", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "rel" [label="Release tag and frozen\nconfiguration to Production;\ncomparison report", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "pre" [label="Pre-Prod from a production\nbackup; own secrets; e-mail\nand scheduler off", shape=box, style="rounded,filled", color="#2E75B6", fillcolor="#DCE9F7", fontcolor="#101820", penwidth=1.2];
 "mask" [label="mask:data --remark-copy\n(when people without\nproduction access take part)", shape=box, style="rounded,filled", color="#7F7F7F", fillcolor="#F2F2F2", fontcolor="#101820", penwidth=1.2];
 "reh" [label="Cutover rehearsal", shape=box, style="rounded,filled,bold", color="#C00000", fillcolor="#FBE3E3", fontcolor="#101820", penwidth=2.2];
 "reg" [label="Cutover: golive.locked;\nmask:data --register-\nproduction", shape=box, style="rounded,filled,bold", color="#C00000", fillcolor="#FBE3E3", fontcolor="#101820", penwidth=2.2];
 "rm" [label="Pre-Prod removed after\nhypercare", shape=box, style="rounded,filled", color="#7F7F7F", fillcolor="#F2F2F2", fontcolor="#101820", penwidth=1.2];
 "host" -> "dev" [color="#555F6D", penwidth=1.1];
 "host" -> "uat" [color="#555F6D", penwidth=1.1];
 "dev" -> "sit" [color="#555F6D", penwidth=1.1];
 "dev" -> "gh" [color="#555F6D", penwidth=1.1];
 "dev" -> "sec" [color="#555F6D", penwidth=1.1];
 "sec" -> "key" [color="#555F6D", penwidth=1.1];
 "gh" -> "ci" [color="#555F6D", penwidth=1.1];
 "sec" -> "ci" [color="#555F6D", penwidth=1.1];
 "uat" -> "ci" [color="#555F6D", penwidth=1.1];
 "sit" -> "ci" [color="#555F6D", penwidth=1.1];
 "ci" -> "kit" [color="#555F6D", penwidth=1.1];
 "sec" -> "prod" [color="#555F6D", penwidth=1.1];
 "kit" -> "rel" [color="#555F6D", penwidth=1.1];
 "prod" -> "rel" [color="#555F6D", penwidth=1.1];
 "rel" -> "pre" [color="#555F6D", penwidth=1.1];
 "pre" -> "mask" [color="#7F7F7F", penwidth=1.1, style=dashed];
 "pre" -> "reh" [color="#555F6D", penwidth=1.1];
 "mask" -> "reh" [color="#7F7F7F", penwidth=1.1, style=dashed];
 "reh" -> "reg" [color="#C00000", penwidth=2.4];
 "reg" -> "rm" [color="#7F7F7F", penwidth=1.1, style=dashed];
 "key" -> "pre" [color="#548235", penwidth=1.1, label="production keys\nneeded to read a\nrestored copy", fontsize=9, fontcolor="#548235", style=dashed];
}
