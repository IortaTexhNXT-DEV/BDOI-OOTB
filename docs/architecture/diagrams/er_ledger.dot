  "posting_rule_lines" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0065B3"><tr><td colspan="2" bgcolor="#0065B3"><font color="white"><b>posting_rule_lines</b></font></td></tr><tr><td align="left" balign="left"><b>PK</b></td><td align="left">id</td></tr><tr><td align="left"><font color="#5B6776">UK</font></td><td align="left">rule_id, line_no</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">rule_id</td></tr></table>>];
