  "journal_lines" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0065B3"><tr><td colspan="2" bgcolor="#0065B3"><font color="white"><b>journal_lines</b></font></td></tr><tr><td align="left" balign="left"><b>PK</b></td><td align="left">id</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">client_id</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">jv_id</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">policy_id</td></tr></table>>];
  "entry_matches" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0065B3"><tr><td colspan="2" bgcolor="#0065B3"><font color="white"><b>entry_matches</b></font></td></tr><tr><td align="left" balign="left"><b>PK</b></td><td align="left">id</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">credit_line_id</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">debit_line_id</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">write_off_jv_id</td></tr></table>>];
  "accounting_periods" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0065B3"><tr><td colspan="2" bgcolor="#0065B3"><font color="white"><b>accounting_periods</b></font></td></tr><tr><td align="left" balign="left"><b>PK</b></td><td align="left">period</td></tr><tr><td align="left"><font color="#0065B3">FK</font></td><td align="left">fiscal_year</td></tr></table>>];
