// BrokerVerse logical component view (document 01). Render: python3 ../tools/render_diagrams.py
digraph G {
  graph [rankdir=TB, fontname="Nunito", fontsize=11, nodesep=0.25, ranksep=0.35, pad=0.2, compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#EAF6FD", color="#0065B3", fontname="Nunito", fontsize=10.5, margin="0.1,0.05"];
  edge  [color="#5B6776", fontname="Nunito", fontsize=9, arrowsize=0.7];

  user [label="Users (browser): broker staff, agents, approvers", fillcolor="#FFFFFF"];
  cdn [label="Static hosting: S3 + CloudFront (target) or nginx container", shape=box3d, fillcolor="#FFFFFF"];
  client [label="Client / customer\n(e-mailed quote approval link)", fillcolor="#FFFFFF"];

  subgraph cluster_web { label="Presentation tier: BrokerVerse SPA (React 18, PrimeReact, Redux Toolkit)"; style="rounded"; color="#00ACF1"; fontcolor="#0065B3";
    spa_ops [label="Operations\nleads, clients, quotation,\npolicy, claims, renewals"];
    spa_fin [label="Accounts / finance\nreceipts, JV, disbursement,\nremittance, incentive"];
    spa_cfg [label="Product configurator,\nreinsurance, reports,\ndashboards"];
    spa_adm [label="Master / admin\nusers, roles, settings,\nschedules, audit trail"];
    spa_core [label="Shared front-end services: API client + token refresh, route guard,\nsystem settings / branding, i18n, dialogs and toasts", fillcolor="#FFFFFF"];
  }

  subgraph cluster_api { label="Application tier: BrokerVerse API (Node.js 22, Express 4), stateless"; style="rounded"; color="#00ACF1"; fontcolor="#0065B3";
    pipeline [label="HTTP pipeline: request id, helmet, CORS, pino-http log, rate limit,\nJSON limit, signed file links, error envelope", fillcolor="#FFFFFF"];
    modules [label="32 business modules (src/modules, 568 routes)\nauth, users, leads, clients, quotations, policies, endorsements, claims, renewals,\nreceipts, collections, accounting, journal-vouchers, disbursements, payments,\ncommission, remittance, reinsurance, incentive, product-configurator, masters,\nreports, dashboard, documents, uploads, notifications, schedules, ..."];
    sched [label="Scheduler (node-cron)\n9 jobs, advisory lock per run"];
    shared [label="Shared services (src/lib)\nauth, permissions, record scope, registry,\nsettings cache, audit, numbering, outbox,\nsecrets, dates / money, validation", fillcolor="#FFFFFF"];
    docs [label="Document engines\nPDF / XLSX / CSV writers\n(no external libraries)"];
  }

  db [label="PostgreSQL 16\n102 tables, 32 migrations\n(RDS Multi-AZ target)", shape=cylinder, fillcolor="#FFFFFF"];
  files [label="File store (UPLOAD_DIR)\nuploads, photos, reports\n(EFS target)", shape=folder, fillcolor="#FFFFFF"];
  smtp [label="SMTP server\n(SMTP_URL)", shape=component, fillcolor="#FFFFFF"];

  user -> cdn [label=" HTTPS: load SPA"];
  cdn -> spa_fin [lhead=cluster_web];
  spa_ops -> spa_core [style=invis]; spa_fin -> spa_core [style=invis]; spa_cfg -> spa_core [style=invis]; spa_adm -> spa_core [style=invis];
  spa_core -> pipeline [label=" HTTPS /api, JWT bearer", lhead=cluster_api];
  client -> pipeline [label=" public approval link", style=dashed];
  pipeline -> modules; sched -> modules [label=" job handlers"]; modules -> shared; modules -> docs;
  shared -> db [label=" pg pool (10)"]; docs -> files; shared -> smtp [label=" outbox job", style=dashed];
  { rank=same; sched; pipeline; }
  { rank=same; db; files; smtp; }
}
