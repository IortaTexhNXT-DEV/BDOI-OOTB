// BrokerVerse OOTB logical component view (document 01). Render: python3 ../tools/render_diagrams.py
digraph G {
  graph [rankdir=TB, fontname="Nunito", fontsize=11, nodesep=0.25, ranksep=0.35, pad=0.2, compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#EAF6FD", color="#0065B3", fontname="Nunito", fontsize=10.5, margin="0.1,0.05"];
  edge  [color="#5B6776", fontname="Nunito", fontsize=9, arrowsize=0.7];

  user [label="Broker staff (browser): Sales & Marketing, Processing Team, Operations,\nClaims, Accounting, Accounting Manager, System Administrator", fillcolor="#FFFFFF"];
  cdn [label="Static hosting: S3 + CloudFront\n(nginx container in Docker Compose)", shape=box3d, fillcolor="#FFFFFF"];
  client [label="Client\n(e-mailed quote approval link)", fillcolor="#FFFFFF"];

  subgraph cluster_web { label="Presentation tier: BrokerVerse SPA (React 18, PrimeReact, Redux Toolkit)"; style="rounded"; color="#00ACF1"; fontcolor="#0065B3";
    spa_ops [label="Operations\nleads, quotations, broker slips,\nplacement, policies, endorsements,\nclaims, renewals"];
    spa_fin [label="Accounts\nbilling, receipts, remittance,\ncommission, JV, disbursements,\nperiod end, bank reconciliation"];
    spa_cfg [label="Product configurator,\nreinsurance, reports,\ndashboards"];
    spa_adm [label="Master\nusers, roles, configuration,\nnumbering, posting rules,\nuploads, schedules, audit"];
    spa_core [label="Shared front-end services: API client and token refresh, route guard,\nsystem settings and branding, i18n, dialogs and toasts", fillcolor="#FFFFFF"];
  }

  subgraph cluster_api { label="Application tier: BrokerVerse API (Node.js 22, Express 4), stateless"; style="rounded"; color="#00ACF1"; fontcolor="#0065B3";
    pipeline [label="HTTP pipeline: request id, helmet, CORS, pino-http log, rate limit,\nJSON limit, signed file links, error envelope", fillcolor="#FFFFFF"];
    modules [label="38 business modules (src/modules, 717 routes)\nsales and policy, placement and co-insurance, claims, renewals,\nbilling and receipts, remittance, commission and rate matrix, posting rules,\nperiod end and BIR tax, bank reconciliation, reinsurance, incentive,\nproduct configurator, masters and uploads, reports, administration"];
    sched [label="Scheduler (node-cron)\n15 jobs in Asia/Manila time,\nadvisory lock per run"];
    shared [label="Shared services (src/lib)\nauth, permissions, registry, settings cache,\naudit, document numbering, e-mail outbox,\nsecrets, business dates, money, validation", fillcolor="#FFFFFF"];
    docs [label="File engines\none PDF engine with the Company\nletterhead; XLSX, CSV, ZIP"];
  }

  db [label="PostgreSQL 16\n138 tables, 58 migrations\ntime zone Asia/Manila", shape=cylinder, fillcolor="#FFFFFF"];
  files [label="File store (UPLOAD_DIR)\npersistent volume:\nuploads, photos, reports", shape=folder, fillcolor="#FFFFFF"];
  smtp [label="Office 365 SMTP\n(SMTP_URL)", shape=component, fillcolor="#FFFFFF"];

  user -> cdn [label=" HTTPS: load SPA"];
  cdn -> spa_fin [lhead=cluster_web];
  spa_ops -> spa_core [style=invis]; spa_fin -> spa_core [style=invis]; spa_cfg -> spa_core [style=invis]; spa_adm -> spa_core [style=invis];
  spa_core -> pipeline [label=" HTTPS /api, JWT bearer", lhead=cluster_api];
  client -> pipeline [label=" public approval link", style=dashed];
  pipeline -> modules; sched -> modules [label=" job handlers"]; modules -> shared; modules -> docs;
  shared -> db [label=" pg pool (10)"]; docs -> files; shared -> smtp [label=" outbox job", style=dashed];
  { rank=same; sched; pipeline; }
  { rank=same; db; files; smtp; }
}
