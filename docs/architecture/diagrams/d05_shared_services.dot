// Shared service components (document 05): backend src/lib and front-end shared utilities.
digraph G {
  graph [rankdir=LR, fontname="Nunito", fontsize=11, nodesep=0.18, ranksep=0.5, pad=0.2, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#EAF6FD", color="#0065B3", fontname="Nunito", fontsize=9.5];
  edge  [color="#9FB3C8", arrowsize=0.5, fontname="Nunito", fontsize=9];
  subgraph cluster_fe { label="Front end (brokerverse/src)"; style="rounded"; color="#00ACF1"; fontcolor="#0065B3";
    fe1 [label="API access\nutility/interceptor.js (axios)\nutility/sessionRefresh.js (fetch)\nservices/*Service.js (57)"];
    fe2 [label="Access control\nroutes/ProtectedRoute\nutils/menuPermissions.js, canOpen.js\nutility/idleTimeout.js"];
    fe3 [label="Configuration, theme and help\ntheme/runtime/themeEngine.js (branding)\nHelpPanel (F1, helpRoutes.js)\ndateFormat.js, useFormatCurrency"];
    fe4 [label="UI services\nAppDialogs + utility/dialogs.js\nToast / toastUtils.js\nNotificationContext (30 s poll)\nS3FileUpload, i18n (en, th), utility/logger"];
  }
  subgraph cluster_be { label="Backend (backend/src/lib, jobs)"; style="rounded"; color="#00ACF1"; fontcolor="#0065B3";
    b1 [label="Identity and access\nauth.js (JWT, token version, roles,\npermissions), password.js, totp.js,\nscope.js (record scope), loginHistory.js"];
    b2 [label="Request handling\nregistry.js (define, OpenAPI), validate.js (zod),\nerrors.js, respond.js (envelope, paging),\nrateLimit.js, uploadLimits.js, health.js"];
    b3 [label="Business utilities\nsettings.js (cache), settingOwners.js,\ndates.js (Asia/Manila), money.js, currency.js,\nnumbering.js, address.js (PH format),\nmakerChecker.js, template.js, posting engine"];
    b4 [label="Records and messaging\naudit.js + auditEvents.js, mailer.js (outbox,\nbranded layout), notifications, secrets.js,\npii.js + piiPolicy.js (package B),\nfileLinks.js, uploads/storage.js"];
    b6 [label="Integration framework\nmodules/integrations/framework:\nregistry, connectors, outbox, inbox,\nadapters, fake provider"];
    b5 [label="Batch and documents\njobs/scheduler.js (advisory lock),\nhousekeeping.js, reports engine,\npdf/ + letterhead.js + e-signatures,\nxlsx.js (branded), csv.js, zip.js"];
  }
  db [label="PostgreSQL", shape=cylinder, fillcolor="#FFFFFF"];
  fe1 -> b2; fe2 -> b1 [style=dashed]; fe3 -> b3 [style=dashed, label=" GET /system-settings ", fontsize=8];
  b1 -> db; b2 -> db [style=invis]; b3 -> db; b4 -> db; b5 -> db; b6 -> db;
}
