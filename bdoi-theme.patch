diff --git a/src/theme/bdoi/bdoi.scss b/src/theme/bdoi/bdoi.scss
new file mode 100644
index 0000000..704015d
--- /dev/null
+++ b/src/theme/bdoi/bdoi.scss
@@ -0,0 +1,436 @@
+// BDOI theme for iNXT BrokerVerse: the application shell (sidebar, top bar, content area), the
+// sign-in page and the PrimeReact components, styled to the BDO Style Guide. Styling only: no
+// screen, route or behaviour changes. Loaded after the generated PrimeReact theme and index.scss.
+@import "./tokens";
+
+// ---------------------------------------------------------------- base
+
+body,
+.p-component {
+  font-family: $font-body;
+}
+
+body {
+  background-color: $color-bg !important;
+  color: $color-text;
+}
+
+h1,
+h2,
+h3,
+h4,
+h5,
+h6 {
+  font-family: $font-heading;
+}
+
+// ---------------------------------------------------------------- shell: sidebar
+
+.protected__layout__container {
+  .protected__layout__sidebar__container {
+    background-color: $color-surface !important;
+    background: $color-surface !important;
+    border-right: 1px solid $color-border;
+    box-shadow: none;
+
+    .sidebar-close-btn {
+      background: $color-bg;
+      color: $brand-navy;
+
+      &:hover {
+        background: $brand-blue-050;
+      }
+    }
+  }
+
+  .protected__layout__content__space .main__content {
+    background-color: $color-bg;
+  }
+}
+
+.sidebar__overall__container {
+  background-color: $color-surface;
+
+  // Brand lockup: the BDO Insure logo with the product name under it.
+  .bdoi-brand {
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 8px;
+    padding: 8px 12px 24px;
+    text-decoration: none;
+
+    img {
+      height: 36px;
+      width: auto;
+    }
+
+    .bdoi-brand-product {
+      font-size: 12px;
+      font-weight: 700;
+      letter-spacing: 0.3px;
+      color: $color-text-muted;
+    }
+  }
+
+  // Navigation text is Header Blue on white.
+  .list li div,
+  .itemname__container,
+  .itemname__container.collapsed,
+  .singleitemname__container,
+  .singleitemname__container__active,
+  .submunusidebar__container li div {
+    color: $brand-navy !important;
+    font-family: $font-body;
+  }
+
+  .list li div:hover {
+    color: $brand-navy !important;
+  }
+
+  // Group rows carry no fill; only the entry of the current page is tinted (SideBarItem).
+  .divcontent__sidebar_overall,
+  .divcontent__sidebardeactive__overall {
+    background-color: transparent;
+    color: $brand-navy !important;
+
+    &:hover {
+      background-color: $color-bg;
+      color: $brand-navy !important;
+    }
+  }
+
+  .submunusidebar__container {
+    border-left-color: $color-border;
+
+    li div:hover {
+      background-color: $color-bg;
+      color: $brand-navy !important;
+    }
+  }
+
+  // Menu icons take the text colour instead of their white / indigo fills.
+  li svg [fill]:not([fill="none"]) {
+    fill: currentColor;
+  }
+
+  li svg [stroke]:not([stroke="none"]) {
+    stroke: currentColor;
+  }
+
+  .itemarrow__container svg path {
+    fill: currentColor;
+  }
+
+  // Menu search
+  .menu-search-container {
+    .p-input-icon-left {
+      i {
+        color: $color-placeholder;
+      }
+
+      .menu-search-input {
+        background-color: $color-surface;
+        border: 1px solid $brand-field-blue;
+        border-radius: $radius-sm;
+        color: $color-text !important;
+        font-family: $font-body;
+
+        &::placeholder,
+        &::-webkit-input-placeholder,
+        &::-moz-placeholder,
+        &:-ms-input-placeholder {
+          color: $color-placeholder !important;
+        }
+
+        &:focus {
+          border-color: $brand-blue;
+          box-shadow: $focus-ring;
+          color: $color-text !important;
+        }
+      }
+    }
+
+    .search-results-dropdown {
+      background-color: $color-surface;
+      border-color: $color-border;
+      box-shadow: $shadow-md;
+
+      &::-webkit-scrollbar-track {
+        background: $color-surface;
+      }
+
+      &::-webkit-scrollbar-thumb {
