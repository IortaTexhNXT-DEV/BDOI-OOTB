{
  "name": "brokerverse-backend",
  "version": "1.0.0",
  "description": "BrokerVerse insurance broking platform: REST API and scheduled jobs (Node.js, PostgreSQL)",
  "author": "iorta TechNXT",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "export:api": "node src/tools/export-api.js",
    "purge:sample": "node scripts/purge-sample-data.js",
    "reset:transactions": "node scripts/reset-transactions.js",
    "rehearsal:golive": "node scripts/golive-rehearsal.js",
    "check:settings": "node scripts/check-settings.js",
    "compare:environments": "node scripts/compare-environments.js",
    "mask:data": "node scripts/mask-data.js",
    "pii:rotate": "node scripts/rotate-pii-key.js",
    "test": "vitest run",
    "lint": "eslint src test scripts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
