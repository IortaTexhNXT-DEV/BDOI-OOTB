# Copy to .env. Every value here is deployment configuration; business parameters live in the app_settings table.
# With NODE_ENV=production the API refuses to start unless JWT_SECRET, DATA_ENCRYPTION_KEY, CORS_ORIGINS and
# PUBLIC_BASE_URL are set to real values (docs/DEPLOY.md).
PORT=8000
NODE_ENV=development
DATABASE_URL=postgres://brokerverse:brokerverse@127.0.0.1:5432/brokerverse
# openssl rand -hex 32 (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string
# openssl rand -hex 32, different from JWT_SECRET; keep it with the database backups
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5051
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000
FILE_URL_TTL_SECONDS=1800
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=10
IMPORT_MAX_MB=10
IMPORT_MAX_INFLATED_MB=50
IMPORT_MAX_ROWS=20000
JSON_BODY_LIMIT=2mb
SMTP_URL=
LOG_LEVEL=info
# Demo data (sample leads, clients, quotations, policies, claims, receipts, remittances, journals, sample users).
# Default: true in development / test, false with NODE_ENV=production; an explicit value wins. Reference data
# (settings, roles, masters, chart of accounts, product templates, report catalogue) is always seeded.
# To remove demo data from a database started with it: CONFIRM_PURGE=yes npm run purge:sample (docs/DEPLOY.md).
SEED_SAMPLE_DATA=
# Run the scheduled jobs on this instance (default true). Several instances may run it: each job run takes a
# PostgreSQL advisory lock, so only one instance executes a given run.
SCHEDULER_ENABLED=true
# Timeout of the database check in GET /api/health (milliseconds, default 2000)
HEALTH_DB_TIMEOUT_MS=2000
